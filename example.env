# ============================================================
# Server
# ============================================================

PORT=3000

# Public application URL, without a trailing slash.
# Used for canonical URLs, Open Graph metadata, and sitemap generation.
# APP_URL=https://devhub.example.com

# Set to 1 when running behind a reverse proxy (e.g., Nginx or Cloudflare)
# so that client IP addresses are correctly identified for rate limiting.
# TRUST_PROXY=1

# ============================================================
# Authentication
# ============================================================

# Secret used to sign JWT access and refresh tokens.
# Generate a strong, random value in production; never commit the real key.
JWT_SECRET='your_super_secret_key_here'

# Access token lifetime. Refresh token lifetime is handled separately
# by the session service.
JWT_EXPIRES_IN='7d'

# ============================================================
# Database
# ============================================================

MONGODB_URI='mongodb://admin:admin_pass@localhost:27017/devhub?authSource=admin'

# ============================================================
# Roles — Initial Setup
# ============================================================

# If this email matches an existing user, that user is promoted to the
# developer role during the initial bootstrap process.
DEVELOPER_EMAIL='your-email@example.com'

# ============================================================
# GitHub Integration
# ============================================================

# Personal Access Token used to authenticate requests to the GitHub REST API.
# 
# Strongly recommended for any deployment beyond local development.
# Without a token, GitHub enforces a quota of 60 requests per hour per IP
# address, which is exhausted quickly and blocks project synchronisation
# for all users.
# 
# With a token, the quota rises to 5,000 requests per hour.
# 
# Required scopes:
# - No scope required for public repositories.
# - `repo` scope required when synchronising private repositories.
# 
# Create a token at: https://github.com/settings/tokens
# 
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Maximum number of days to wait before re-synchronising repository metadata.
# Shorter intervals consume more GitHub quota. Defaults to 6 hours when unset.
# GITHUB_SYNC_MAX_AGE_HOURS=6

# ============================================================
# Mail — Email Delivery
# ============================================================

# Delivery mode:
# log  = Log messages to the console (default; development only).
# smtp = Deliver messages through an SMTP server.
MAIL_MODE=log

# Sender identity.
MAIL_FROM_NAME="My App"
MAIL_FROM_ADDRESS=noreply@example.com

# Optional reply-to address.
# MAIL_REPLY_TO=support@example.com

# Optional HELO/EHLO hostname required by some SMTP servers.
# MAIL_HELO_NAME=myapp.com

# When true, the application terminates if SMTP initialisation fails.
# MAIL_FAIL_FAST=true

# Enable verbose SMTP debugging output.
# MAIL_DEBUG=false

# ============================================================
# SMTP — Required Only When MAIL_MODE=smtp
# ============================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Transport security is inferred from the port:
# 465     = implicit TLS (secure) enabled.
# other   = secure disabled by default; STARTTLS is negotiated when
# supported by the server.
# SMTP_SECURE=false

# Optional SMTP connection and operation timeout, in milliseconds.
# SMTP_TIMEOUT_MS=15000

# Development only. Never enable insecure SMTP connections in production.
# SMTP_ALLOW_INSECURE=false