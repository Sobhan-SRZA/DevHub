PORT=3000
JWT_SECRET='your_super_secret_key_here'
JWT_EXPIRES_IN='7d'

# Public application URL (without a trailing slash).
# Used for canonical URLs, Open Graph metadata, and sitemap generation.
# APP_URL=https://devhub.example.com

# Set to 1 when running behind a reverse proxy (e.g., Nginx or Cloudflare)
# to correctly identify client IP addresses for rate limiting.
# TRUST_PROXY=1

MONGODB_URI='mongodb://admin:admin_pass@localhost:27017/devhub?authSource=admin'

# ============================================================
# Roles — Initial Setup
# ============================================================

# If this email matches an existing user, that user will be promoted
# to the developer role during the initial bootstrap process.
DEVELOPER_EMAIL='your-email@example.com'

# ============================================================
# Mail — Email Delivery Configuration
# ============================================================

# Delivery mode:
# log  = Log email messages to the console (default; development only).
# smtp = Send emails through an SMTP server.
MAIL_MODE=log

# Sender information.
MAIL_FROM_NAME="My App"
MAIL_FROM_ADDRESS=noreply@example.com

# Optional reply-to address.
# MAIL_REPLY_TO=support@example.com

# Optional HELO/EHLO hostname required by some SMTP servers.
# MAIL_HELO_NAME=myapp.com

# Set to true to terminate the application if SMTP initialization fails.
# MAIL_FAIL_FAST=true

# Enable verbose SMTP debugging logs.
# MAIL_DEBUG=false

# ============================================================
# SMTP — Required Only When MAIL_MODE=smtp
# ============================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Transport security is determined automatically based on the port:
# 465 = secure connection enabled; other ports = disabled by default.
# SMTP_SECURE=false

# Optional SMTP connection and operation timeout, in milliseconds.
# SMTP_TIMEOUT_MS=15000

# Development only. Never enable insecure SMTP connections in production.
# SMTP_ALLOW_INSECURE=false