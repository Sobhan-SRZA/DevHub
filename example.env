PORT=3000
JWT_SECRET='your_super_secret_key_here'
JWT_EXPIRES_IN='7d'

# آدرس عمومی سایت (بدون اسلش انتهایی) — برای canonical، Open Graph و sitemap
# APP_URL=https://devhub.example.com

# پشت reverse proxy (nginx/cloudflare) روی 1 بگذارید تا IP واقعی برای rate-limit درست باشد
# TRUST_PROXY=1

MONGODB_URI='mongodb://admin:admin_pass@localhost:27017/devhub?authSource=admin'

# ============================================================
# Roles — Bootstrap
# ============================================================
# اگه این ایمیل وجود داشته باشه، بار اول به developer ارتقا پیدا می‌کنه
DEVELOPER_EMAIL='your-email@example.com'

# ============================================================
# MAIL — ارسال ایمیل
# ============================================================
# log  = فقط چاپ در کنسول (پیش‌فرض — برای dev)
# smtp = ارسال واقعی
MAIL_MODE=log

# فرستنده
MAIL_FROM_NAME="My App"
MAIL_FROM_ADDRESS=noreply@example.com

# پاسخ به (اختیاری)
# MAIL_REPLY_TO=support@example.com

# HELO name (اختیاری — برای بعضی SMTP serverها لازمه)
# MAIL_HELO_NAME=myapp.com

# اگه true: خطای SMTP موقع استارتاپ باعث exit می‌شه
# MAIL_FAIL_FAST=true

# debug SMTP (verbose logs)
# MAIL_DEBUG=false

# ============================================================
# SMTP — فقط اگه MAIL_MODE=smtp
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# secure: خودکار بر اساس پورت (465 = true، بقیه = false)
# SMTP_SECURE=false

# timeout
# SMTP_TIMEOUT_MS=15000

# فقط برای dev! هرگز در production true نکن
# SMTP_ALLOW_INSECURE=false