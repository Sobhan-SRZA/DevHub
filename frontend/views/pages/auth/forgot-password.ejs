<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
  <!-- SEO metadata for the forgot-password page -->
  <%- include("../../components/seo-head", {
    title: "Forgot Password",
    description: "Recover your DevHub account password.",
    noindex: true,
    canonicalPath: "/auth/forgot-password",
    extraStyles: ["/styles/dialog.css", "/styles/form-errors.css", "/styles/auth.css", "/styles/auth/password-reset.css"]
  }) %>
</head>

<body>
  <!-- Site header and global error dialog -->
  <%- include("../../components/header") %>
  <%- include("../../components/dialogError") %>

  <section class="container auth">
    <div class="auth-card pr-card">
      <!-- Page icon -->
      <div class="pr-icon pr-icon--forgot">
        <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>

      <h2 class="pr-title">Forgot Password</h2>
      <p class="pr-sub">
        Enter your account email to receive a recovery code.
      </p>

      <!-- Recovery request form -->
      <form class="pr-form" id="forgotForm" novalidate>
        <div class="field">
          <label for="email">Email <span class="req">*</span></label>
          <div class="pr-input-icon">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <input id="email" type="email" name="email" placeholder="you@example.com" autocomplete="email" dir="ltr" required>
          </div>
        </div>

        <button type="submit" class="auth-btn" id="submitBtn">
          Send Recovery Code
        </button>
      </form>

      <!-- Informational note about email enumeration protection -->
      <div class="pr-info">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        <span>If the email exists in our system, a code will be sent to you.</span>
      </div>

      <!-- Footer link back to sign in -->
      <p class="pr-foot">
        Remembered your password?
        <a href="/login" class="auth-link">Back to sign in</a>
      </p>
    </div>
  </section>

  <script src="/js/form-errors.js"></script>
  <script src="/js/auth/forgot-password.js"></script>
</body>

</html>