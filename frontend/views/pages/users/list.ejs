<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
  <!-- SEO metadata -->
  <%- include("../../components/seo-head", {
    title: "Users",
    description: "A directory of developers and project creators on DevHub.",
    canonicalPath: "/users",
    keywords: "DevHub users, developers, profiles"
  }) %>
</head>

<body>
  <!-- Site header -->
  <%- include("../../components/header") %>

  <main class="list-page users-page">
    <!-- Page header -->
    <div class="list-page__head">
      <h1 class="list-page__title">Users</h1>
      <p class="list-page__sub">Developers and creators of open-source projects</p>
    </div>

    <!-- Search and sorting controls -->
    <div class="list-toolbar">
      <input type="search" id="usersSearch" placeholder="Search by name or username…" autocomplete="off">
      <select id="usersSort">
        <option value="recent">Newest</option>
        <option value="name">Name</option>
        <option value="projects">Most projects</option>
      </select>
    </div>

    <!-- Results metadata -->
    <div class="list-meta" id="usersMeta"></div>

    <!-- User grid -->
    <div class="list-grid" id="usersGrid">
      <div class="home-loading" style="grid-column:1/-1">
        <div class="home-loading__spinner"></div>
        <p>Loading…</p>
      </div>
    </div>

    <!-- Pagination -->
    <div class="list-pagination" id="usersPagination"></div>
  </main>

  <!-- Page script -->
  <script defer src="/js/pages/users-list.js"></script>

  <!-- Site footer -->
  <%- include("../../components/footer") %>
</body>

</html>