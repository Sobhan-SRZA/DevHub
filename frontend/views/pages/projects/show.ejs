<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
  <%- include("../../components/seo-head", {
    title: (typeof seo !== "undefined" && seo.title) ? seo.title : "Project",
    description: (typeof seo !== "undefined" && seo.description) ? seo.description : "Explore project details, ratings, and reviews on DevHub.",
    keywords: (typeof seo !== "undefined" && seo.keywords) ? seo.keywords : "open-source project, DevHub",
    canonicalPath: (typeof seo !== "undefined" && seo.canonicalPath) ? seo.canonicalPath : ("/projects/" + (typeof idOrSlug !== "undefined" ? idOrSlug : "")),
    ogImage: (typeof seo !== "undefined" && seo.ogImage) ? seo.ogImage : undefined,
    ogType: "article",
    extraStyles: ["/styles/dialog.css", "/styles/form-errors.css", "/styles/markdown-editor.css", "/styles/projects/show.css"],
    jsonLd: (typeof seo !== "undefined" && seo.jsonLd) ? seo.jsonLd : undefined
  }) %>
</head>

<body>
  <%- include("../../components/header") %>
  <%- include("../../components/dialogError") %>

  <!-- ============================= -->
  <!-- SHARE DIALOG                  -->
  <!-- ============================= -->
  <div class="modal-backdrop" id="shareBackdrop"></div>
  <div class="modal modal--sm" id="shareModal" role="dialog">
    <div class="modal__header">
      <h3 class="modal__title">Share Project</h3>
      <button type="button" class="modal__close" id="shareClose">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="modal__body">
      <div class="share-link">
        <input type="text" id="shareUrlInput" readonly>
        <button type="button" class="btn-secondary" id="copyShareUrl">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          Copy
        </button>
      </div>

      <div class="share-socials">
        <a class="share-btn share-btn--tw" id="shareTwitter" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
          Twitter
        </a>
        <a class="share-btn share-btn--tg" id="shareTelegram" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z" />
          </svg>
          Telegram
        </a>
        <a class="share-btn share-btn--wa" id="shareWhatsapp" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          WhatsApp
        </a>
      </div>
    </div>
  </div>

  <main class="proj-page" id="projectPage" data-project-id="<%= idOrSlug %>">
    <!-- Loading state -->
    <div class="proj-loading" id="pageLoading">
      <div class="proj-loading__spinner"></div>
      <p>Loading project...</p>
    </div>

    <!-- Error state -->
    <div class="proj-error" id="pageError" style="display:none;">
      <div class="proj-error__icon">⚠️</div>
      <h2 class="proj-error__title" id="errorTitle">Project Not Found</h2>
      <p class="proj-error__sub" id="errorSub">The project may have been deleted or you may not have permission to access it.</p>
      <a href="/projects" class="btn-primary">Back to Projects</a>
    </div>

    <!-- Project content -->
    <div class="proj-content" id="pageContent" style="display:none;">

      <!-- ============ HEADER ============ -->
      <section class="proj-header container">
        <div class="proj-header__breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/projects">Projects</a>
          <span>/</span>
          <span id="breadcrumbName">—</span>
        </div>

        <div class="proj-header__main">
          <div class="proj-header__avatar" id="projectAvatar">?</div>

          <div class="proj-header__info">
            <div class="proj-header__top">
              <h1 class="proj-header__title" id="projectTitle">—</h1>
              <span class="proj-status" id="projectStatus">—</span>
            </div>

            <p class="proj-header__short" id="projectShort">—</p>

            <div class="proj-header__owner" id="projectOwner">
              <span class="proj-header__owner-label">Created by</span>
              <a href="#" class="proj-header__owner-link" id="ownerLink">
                <span class="proj-header__owner-avatar" id="ownerAvatar"></span>
                <span class="proj-header__owner-name" id="ownerName">—</span>
              </a>
            </div>

            <div class="proj-header__tags" id="projectTags"></div>
          </div>

          <div class="proj-header__actions">
            <button type="button" class="btn-secondary" id="btnShare">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="18" cy="5" r="3"></circle>
                <circle cx="6" cy="12" r="3"></circle>
                <circle cx="18" cy="19" r="3"></circle>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
              </svg>
              Share
            </button>

            <a class="btn-primary" id="btnGithub" style="display:none;" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
                <path d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.2 3.44 9.61 8.21 11.17.6.11.82-.26.82-.58v-2.02c-3.34.71-4.04-1.58-4.04-1.58-.55-1.36-1.34-1.72-1.34-1.72-1.09-.73.08-.71.08-.71 1.2.08 1.84 1.21 1.84 1.21 1.07 1.79 2.8 1.27 3.49.97.11-.76.42-1.27.76-1.56-2.67-.3-5.47-1.31-5.47-5.82 0-1.28.47-2.33 1.24-3.15-.13-.3-.54-1.51.12-3.14 0 0 1-.31 3.3 1.21a11.6 11.6 0 0 1 6 0c2.3-1.52 3.3-1.21 3.3-1.21.66 1.63.25 2.84.12 3.14.77.82 1.24 1.87 1.24 3.15 0 4.52-2.81 5.52-5.49 5.81.43.37.81 1.09.81 2.19v3.25c0 .32.22.7.83.58 4.77-1.56 8.2-5.97 8.2-11.17C24 5.78 18.63.5 12 .5z" />
              </svg>
              GitHub
            </a>

            <a class="btn-secondary" id="btnEdit" style="display:none;" href="#">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
              </svg>
              Edit
            </a>
          </div>
        </div>

        <!-- Statistics bar -->
        <div class="proj-stats" id="projectStats">
          <div class="proj-stat">
            <div class="proj-stat__icon" style="--c:#fbbf24">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
            </div>
            <div class="proj-stat__body">
              <span class="proj-stat__value" id="statStars">0</span>
              <span class="proj-stat__label">Stars</span>
            </div>
          </div>

          <div class="proj-stat">
            <div class="proj-stat__icon" style="--c:#a78bfa">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="18" r="3"></circle>
                <circle cx="6" cy="6" r="3"></circle>
                <circle cx="18" cy="6" r="3"></circle>
                <path d="M18 9v1a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9"></path>
                <path d="M12 12v3"></path>
              </svg>
            </div>
            <div class="proj-stat__body">
              <span class="proj-stat__value" id="statForks">0</span>
              <span class="proj-stat__label">Forks</span>
            </div>
          </div>

          <div class="proj-stat">
            <div class="proj-stat__icon" style="--c:#34d399">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </div>
            <div class="proj-stat__body">
              <span class="proj-stat__value" id="statDownloads">0</span>
              <span class="proj-stat__label">Downloads</span>
            </div>
          </div>

          <div class="proj-stat">
            <div class="proj-stat__icon" style="--c:#ec4899">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
            </div>
            <div class="proj-stat__body">
              <span class="proj-stat__value" id="statRating">0.0</span>
              <span class="proj-stat__label" id="statRatingCount">No ratings</span>
            </div>
          </div>

          <div class="proj-stat">
            <div class="proj-stat__icon" style="--c:#6ebbff">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </div>
            <div class="proj-stat__body">
              <span class="proj-stat__value" id="statViews">0</span>
              <span class="proj-stat__label">Views</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ CONTENT ============ -->
      <div class="proj-body container">

        <!-- LEFT COLUMN -->
        <div class="proj-main">

          <!-- ============ GALLERY ============ -->
          <section class="proj-section" id="gallerySection" style="display:none;">
            <div class="proj-section__head">
              <h2 class="proj-section__title">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <circle cx="8.5" cy="8.5" r="1.5"></circle>
                  <polyline points="21 15 16 10 5 21"></polyline>
                </svg>
                Project Gallery
                <span class="proj-section__count" id="imagesCount">0</span>
              </h2>
            </div>

            <div class="proj-gallery" id="gallery"></div>
          </section>

          <!-- ============ DESCRIPTION ============ -->
          <section class="proj-section">
            <div class="proj-section__head">
              <h2 class="proj-section__title">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                About This Project
              </h2>
            </div>

            <div class="md-preview-content proj-description" id="projectDescription"></div>
          </section>

          <!-- ============ VIDEO ============ -->
          <section class="proj-section" id="videoSection" style="display:none;">
            <div class="proj-section__head">
              <h2 class="proj-section__title">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="23 7 16 12 23 17 23 7"></polygon>
                  <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                </svg>
                Demo Video
              </h2>
            </div>

            <div class="proj-video" id="videoContainer"></div>
          </section>

          <!-- ============ REVIEWS ============ -->
          <section class="proj-section" id="reviewsSection">
            <div class="proj-section__head">
              <h2 class="proj-section__title">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
                User Reviews
                <span class="proj-section__count" id="reviewsCount">0</span>
              </h2>
            </div>

            <!-- Rating summary and distribution -->
            <div class="reviews-summary" id="reviewsSummary">
              <div class="reviews-summary__score">
                <div class="reviews-summary__big" id="avgRating">0.0</div>
                <div class="reviews-summary__stars" id="avgStars"></div>
                <div class="reviews-summary__count" id="avgCount">No ratings</div>
              </div>

              <div class="reviews-summary__dist" id="reviewsDist"></div>
            </div>

            <!-- Current user's review and review form -->
            <div class="review-box" id="reviewBox">
              <div class="review-box__cta" id="reviewCta">
                <div class="review-box__cta-icon">✍️</div>
                <div class="review-box__cta-text">
                  <strong>What do you think?</strong>
                  <small>Share your experience with this project and help others make informed decisions.</small>
                </div>
                <button type="button" class="btn-primary" id="btnWriteReview">
                  Write a Review
                </button>
              </div>

              <form class="review-form" id="reviewForm" style="display:none;">
                <div class="review-form__head">
                  <h3 class="review-form__title" id="reviewFormTitle">New Review</h3>
                  <button type="button" class="review-form__close" id="reviewFormClose">✕</button>
                </div>

                <div class="field">
                  <label>Your Rating <span class="req">*</span></label>
                  <div class="star-rating" id="starRating" data-value="0">
                    <button type="button" data-star="1">★</button>
                    <button type="button" data-star="2">★</button>
                    <button type="button" data-star="3">★</button>
                    <button type="button" data-star="4">★</button>
                    <button type="button" data-star="5">★</button>
                    <span class="star-rating__value" id="starValue">0</span>
                  </div>
                </div>

                <div class="field">
                  <label for="reviewSatisfaction">
                    Satisfaction Level
                    <span class="satisfaction-value" id="satisfactionValue">80%</span>
                  </label>
                  <input id="reviewSatisfaction" type="range" min="0" max="100" value="80" step="5" class="satisfaction-slider">
                  <div class="satisfaction-labels">
                    <span>Very Poor</span>
                    <span>Average</span>
                    <span>Excellent</span>
                  </div>
                </div>

                <div class="field">
                  <label for="reviewTitle">Title <small>(Optional)</small></label>
                  <input id="reviewTitle" type="text" maxlength="100" placeholder="Summarize your review">
                </div>

                <div class="field">
                  <label for="reviewBody">Details <small>(Optional)</small></label>
                  <textarea id="reviewBody" rows="4" maxlength="3000" placeholder="What did you like? What could be improved?"></textarea>
                </div>

                <div class="review-form__actions">
                  <button type="button" class="btn-ghost" id="reviewCancel">Cancel</button>
                  <button type="submit" class="btn-primary" id="reviewSubmit">Submit Review</button>
                </div>
              </form>

              <div class="review-mine" id="reviewMine" style="display:none;"></div>
            </div>

            <!-- Reviews list -->
            <div class="reviews-list" id="reviewsList">
              <div class="dash-loading">Loading reviews...</div>
            </div>
          </section>

          <!-- ============ COMMENTS ============ -->
          <section class="proj-section" id="commentsSection">
            <div class="proj-section__head">
              <h2 class="proj-section__title">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
                Discussion
                <span class="proj-section__count" id="commentsCount">0</span>
              </h2>
            </div>

            <!-- New comment -->
            <form class="comment-form" id="commentForm">
              <div class="comment-form__avatar" id="myAvatar">?</div>
              <div class="comment-form__body">
                <textarea id="commentInput" rows="3" placeholder="Write a comment..." maxlength="2000"></textarea>
                <div class="comment-form__footer">
                  <span class="comment-form__hint">Press <kbd>Ctrl</kbd>+<kbd>Enter</kbd> to submit</span>
                  <button type="submit" class="btn-primary" id="commentSubmit" disabled>
                    Post Comment
                  </button>
                </div>
              </div>
            </form>

            <!-- Login prompt -->
            <div class="comment-login" id="commentLogin" style="display:none;">
              <span>To leave a comment, please</span>
              <a href="/auth/login" class="auth-link">Log in</a>
            </div>

            <!-- Comments list -->
            <div class="comments-list" id="commentsList">
              <div class="dash-loading">Loading comments...</div>
            </div>
          </section>

        </div>

        <!-- RIGHT SIDEBAR -->
        <aside class="proj-side">

          <!-- Download card -->
          <div class="side-card side-card--download" id="downloadCard" style="display:none;">
            <div class="side-card__head">
              <div class="side-card__icon" style="--c:#34d399">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
              </div>
              <div class="side-card__info">
                <strong id="fileVersion">Download Project</strong>
                <small id="fileSize">—</small>
              </div>
            </div>

            <a class="btn-primary side-card__btn" id="downloadBtn" href="#">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              Download File
            </a>

            <div class="side-card__meta" id="fileMeta"></div>
          </div>

          <!-- Project information card -->
          <div class="side-card">
            <h3 class="side-card__title">Project Information</h3>

            <ul class="side-info-list" id="sideInfoList">
              <li>
                <span class="side-info-list__label">Status</span>
                <span class="side-info-list__value" id="infoStatus">—</span>
              </li>
              <li>
                <span class="side-info-list__label">Created</span>
                <span class="side-info-list__value" id="infoCreated">—</span>
              </li>
              <li>
                <span class="side-info-list__label">Last Updated</span>
                <span class="side-info-list__value" id="infoUpdated">—</span>
              </li>
              <li id="infoLicenseRow" style="display:none;">
                <span class="side-info-list__label">License</span>
                <span class="side-info-list__value" id="infoLicense">—</span>
              </li>
              <li id="infoLanguageRow" style="display:none;">
                <span class="side-info-list__label">Primary Language</span>
                <span class="side-info-list__value" id="infoLanguage">—</span>
              </li>
            </ul>
          </div>

          <!-- Tags card -->
          <div class="side-card" id="tagsCard">
            <h3 class="side-card__title">Tags</h3>
            <div class="side-tags" id="sideTags"></div>
          </div>

          <!-- Related projects -->
          <div class="side-card" id="relatedCard" style="display:none;">
            <h3 class="side-card__title">Related Projects</h3>
            <div class="side-related" id="sideRelated"></div>
          </div>

        </aside>

      </div>
    </div>
  </main>

  <!-- ============================= -->
  <!-- LIGHTBOX                      -->
  <!-- ============================= -->
  <div class="lightbox" id="lightbox">
    <button type="button" class="lightbox__close" id="lightboxClose" aria-label="Close">✕</button>
    <button type="button" class="lightbox__nav lightbox__nav--prev" id="lightboxPrev">‹</button>
    <button type="button" class="lightbox__nav lightbox__nav--next" id="lightboxNext">›</button>
    <div class="lightbox__image-wrap">
      <img class="lightbox__image" id="lightboxImage" alt="">
    </div>
    <div class="lightbox__counter" id="lightboxCounter">1 / 1</div>
  </div>

  <%- include("../../components/footer") %>
</body>

<script defer src="/js/form-errors.js"></script>
<script defer src="/js/components/markdown-editor.js"></script>
<script defer src="/js/projects/show.js"></script>

</html>