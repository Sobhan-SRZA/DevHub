<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
  <!-- Apply persisted theme and accent preferences before first paint to prevent flashing. -->
  <meta charset="UTF-8">
  <script>
    (function() {
      try {
        var mode = localStorage.getItem('dh-mode') || 'system';
        var accent = localStorage.getItem('dh-accent') || 'blue';
        var resolvedMode = mode === 'system' ?
          (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark') :
          mode;

        document.documentElement.setAttribute('data-mode', resolvedMode);
        document.documentElement.setAttribute('data-accent', accent);
        document.documentElement.style.colorScheme = resolvedMode;
      } catch (e) {}
    })();
  </script>

  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">

  <!-- Fonts and global styles -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="/styles/index.css">
  <link rel="stylesheet" href="/styles/themes.css">

  <!-- Favicon -->
  <link rel="icon" href="/assets/logo.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/assets/logo.svg">

  <!-- Page-specific styles -->
  <link rel="stylesheet" href="/styles/dialog.css">
  <link rel="stylesheet" href="/styles/form-errors.css">
  <link rel="stylesheet" href="/styles/markdown-editor.css">
  <link rel="stylesheet" href="/styles/dashboard/dashboard.css">
  <link rel="stylesheet" href="/styles/dashboard/dashboard-nav.css">
  <link rel="stylesheet" href="/styles/tailwind.css">
  <link rel="stylesheet" href="/styles/dashboard/settings.css">

  <title>Profile Settings</title>
</head>

<body>
  <%- include("../../components/dialogError") %>

  <div class="dash-layout">
    <%- include("../../components/dashboard-nav") %>
    <%- include("../../components/dash-breadcrumb", { pageTitle: "Settings" }) %>

    <main class="dash-main settings-main">
      <!-- ============ PAGE HEADER ============ -->
      <div class="dash-head">
        <div>
          <h2 class="dash-title">Profile Settings</h2>
          <p class="dash-sub">Manage your account information, security, and public profile.</p>
        </div>
      </div>

      <!-- ============ SETTINGS TABS ============ -->
      <div class="settings-tabs">
        <button type="button" class="st-tab active" data-tab="general">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          General
        </button>

        <button type="button" class="st-tab" data-tab="email">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          Email
        </button>

        <button type="button" class="st-tab" data-tab="password">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          Security
        </button>
      </div>

      <!-- ============================================================
           TAB: GENERAL
           Avatar, display name, username, and biography management.
           ============================================================ -->
      <section class="st-panel active" data-panel="general">
        <!-- Avatar -->
        <div class="st-card">
          <div class="st-card__head">
            <h3 class="st-card__title">Profile Picture</h3>
            <p class="st-card__sub">JPG, PNG, WebP, or GIF — max 5 MB</p>
          </div>

          <div class="avatar-editor">
            <div class="avatar-editor__preview" id="avatarPreview">
              <span id="avatarInitial">?</span>
            </div>

            <div class="avatar-editor__controls">
              <label class="btn-primary avatar-editor__upload">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="17 8 12 3 7 8"></polyline>
                  <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
                Upload Image
                <input type="file" id="avatarInput" accept="image/jpeg,image/png,image/webp,image/gif" hidden>
              </label>

              <button type="button" class="btn-ghost" id="avatarRemove" style="display:none;">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path>
                </svg>
                Remove Image
              </button>
            </div>
          </div>
        </div>

        <!-- Display name and username -->
        <div class="st-card">
          <div class="st-card__head">
            <h3 class="st-card__title">Basic Information</h3>
            <p class="st-card__sub">Your display name and username</p>
          </div>

          <form id="profileForm" class="st-form" novalidate>
            <div class="field">
              <label for="stName">Display Name <span class="req">*</span></label>
              <input id="stName" type="text" name="name" required maxlength="60" placeholder="e.g., John Smith">
            </div>

            <div class="field">
              <label for="stUsername">Username <span class="req">*</span></label>
              <div class="st-username">
                <span class="st-username__prefix">@</span>
                <input id="stUsername" type="text" name="username" required minlength="3" maxlength="20" placeholder="john_smith" dir="ltr">
              </div>
              <div class="field-hint">Lowercase English letters, numbers, _, ., or - only</div>
            </div>

            <div class="st-form__actions">
              <button type="submit" class="btn-primary" id="saveProfileBtn">Save Changes</button>
            </div>
          </form>
        </div>

        <!-- Biography -->
        <div class="st-card">
          <div class="st-card__head">
            <h3 class="st-card__title">About Me</h3>
            <p class="st-card__sub">
              Write a brief description about yourself — Markdown is supported
            </p>
          </div>

          <div id="bioEditorRoot"></div>

          <div class="st-form__actions">
            <button type="button" class="btn-primary" id="saveBioBtn">Save Biography</button>
          </div>
        </div>
      </section>

      <!-- ============================================================
           TAB: EMAIL
           Current email display and a three-state email change flow:
           (A) request change, (B) verify current email, (C) verify new.
           ============================================================ -->
      <section class="st-panel" data-panel="email">
        <!-- Current email -->
        <div class="st-card">
          <div class="st-card__head">
            <h3 class="st-card__title">Email Address</h3>
            <p class="st-card__sub">The current email associated with your account</p>
          </div>

          <div class="email-current">
            <div class="email-current__icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>

            <div class="email-current__info">
              <strong id="currentEmail">—</strong>
              <span class="email-current__badge" id="emailVerifiedBadge">—</span>
            </div>
          </div>
        </div>

        <!-- ============================================
             STATE A: REQUEST EMAIL CHANGE (default)
             ============================================ -->
        <div class="st-card" id="emailStateRequest">
          <div class="st-card__head">
            <h3 class="st-card__title">Change Email</h3>
            <p class="st-card__sub">
              First, you must confirm the code sent to your <strong>current email</strong>.
              The new email will then be registered but must be verified again.
            </p>
          </div>

          <form id="changeEmailForm" class="st-form" novalidate>
            <div class="field">
              <label for="newEmail">New Email <span class="req">*</span></label>
              <input id="newEmail" type="email" name="newEmail" required placeholder="new@example.com" dir="ltr">
            </div>

            <div class="field">
              <label for="confirmPasswordForEmail">Current Password <span class="req">*</span></label>
              <div class="password-wrap">
                <input id="confirmPasswordForEmail" type="password" name="password" required autocomplete="current-password" dir="ltr">
                <button type="button" class="toggle-pass" data-target="confirmPasswordForEmail" aria-label="Show password">
                  <svg class="icon icon-eye" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                  <svg class="icon icon-eye-off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                    <line x1="1" y1="1" x2="23" y2="23"></line>
                  </svg>
                </button>
              </div>
            </div>

            <div class="st-form__actions">
              <button type="submit" class="btn-primary" id="requestEmailBtn">
                Send Code to Current Email
              </button>
            </div>
          </form>
        </div>

        <!-- ============================================
             STATE B: AWAITING CURRENT EMAIL CODE
             ============================================ -->
        <div class="st-card" id="emailStateOldVerify" style="display:none;">
          <div class="st-card__head">
            <h3 class="st-card__title">🔐 Verify Current Email</h3>
            <p class="st-card__sub">
              A 6-digit code was sent to your current email (<span id="oldEmailDisplay">—</span>)
            </p>
          </div>

          <div class="email-pending" style="border-color:rgba(245,158,11,0.3);">
            <div class="email-pending__row">
              <span class="email-pending__label">New email after verification:</span>
              <span class="email-pending__value" id="newEmailDisplay">—</span>
            </div>
            <div class="email-pending__row">
              <span class="email-pending__label">Time remaining:</span>
              <span class="email-pending__value" id="oldVerifyTimer">—</span>
            </div>
          </div>

          <form id="verifyOldEmailForm" class="st-form" novalidate>
            <div class="field">
              <label for="oldEmailCode">Code sent to your current email</label>
              <input id="oldEmailCode" type="text" name="code" maxlength="6" inputmode="numeric" pattern="\d{6}" placeholder="------" autocomplete="one-time-code" class="otp-input" dir="ltr">
            </div>

            <div class="st-form__actions">
              <button type="button" class="btn-ghost" id="cancelOldVerify">Cancel Request</button>
              <button type="submit" class="btn-primary" id="verifyOldEmailBtn">Verify and Change Email</button>
            </div>
          </form>
        </div>

        <!-- ============================================
             STATE C: EMAIL CHANGED, AWAITING NEW VERIFY
             ============================================ -->
        <div class="st-card" id="emailStateNewVerify" style="display:none;">
          <div class="st-card__head">
            <h3 class="st-card__title">✅ Email Changed</h3>
            <p class="st-card__sub">
              Your email has been changed to <strong id="newEmailChanged">—</strong>,
              but it is not yet <strong>verified</strong>.
            </p>
          </div>

          <div class="email-pending" style="border-color:rgba(34,197,94,0.3);">
            <div class="email-pending__row">
              <span class="email-pending__label">New email:</span>
              <span class="email-pending__value" style="color:#4ade80" id="newEmailChangedInline">—</span>
            </div>
            <div class="email-pending__row">
              <span class="email-pending__label">Status:</span>
              <span class="email-pending__value" style="color:#fbbf24">⏳ Pending verification</span>
            </div>
          </div>

          <div class="email-note">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            <span>Until you verify the new email, you cannot create projects.</span>
          </div>

          <div class="st-form__actions">
            <button type="button" class="btn-ghost" id="cancelNewVerify">Cancel and Revert to Previous Email</button>
            <button type="button" class="btn-primary" id="goToVerifyEmail">
              Verify New Email
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
        </div>
      </section>

      <!-- ============================================================
           TAB: PASSWORD
           Two-step password change flow (request + confirmation code)
           and a global "sign out of all devices" danger zone.
           ============================================================ -->
      <section class="st-panel" data-panel="password">
        <div class="st-card">
          <div class="st-card__head">
            <h3 class="st-card__title">Change Password</h3>
            <p class="st-card__sub">
              For security, you will be signed out of all other devices once the password is changed.
            </p>
          </div>

          <!-- Step 1: request password change -->
          <form id="passwordRequestForm" class="st-form" novalidate>
            <div class="field">
              <label for="currentPassword">Current Password <span class="req">*</span></label>
              <div class="password-wrap">
                <input id="currentPassword" type="password" name="currentPassword" required autocomplete="current-password" dir="ltr">
                <button type="button" class="toggle-pass" data-target="currentPassword" aria-label="Show password">
                  <svg class="icon icon-eye" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                  <svg class="icon icon-eye-off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                    <line x1="1" y1="1" x2="23" y2="23"></line>
                  </svg>
                </button>
              </div>
            </div>

            <div class="field">
              <label for="newPassword">New Password <span class="req">*</span></label>
              <div class="password-wrap">
                <input id="newPassword" type="password" name="newPassword" required autocomplete="new-password" dir="ltr">
                <button type="button" class="toggle-pass" data-target="newPassword" aria-label="Show password">
                  <svg class="icon icon-eye" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                  <svg class="icon icon-eye-off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                    <line x1="1" y1="1" x2="23" y2="23"></line>
                  </svg>
                </button>
              </div>

              <!-- Password strength indicator -->
              <div class="pw-strength">
                <div class="pw-strength__bars">
                  <span></span><span></span><span></span><span></span>
                </div>
                <span class="pw-strength__label" id="pwStrengthLabel"></span>
              </div>

              <ul class="pw-rules" id="pwRules">
                <li data-rule="length">At least 8 characters</li>
                <li data-rule="lower">Lowercase letter (a-z)</li>
                <li data-rule="upper">Uppercase letter (A-Z)</li>
                <li data-rule="digit">Digit (0-9)</li>
              </ul>
            </div>

            <div class="field">
              <label for="confirmNewPassword">Confirm New Password <span class="req">*</span></label>
              <div class="password-wrap">
                <input id="confirmNewPassword" type="password" name="confirmPassword" required autocomplete="new-password" dir="ltr">
                <button type="button" class="toggle-pass" data-target="confirmNewPassword" aria-label="Show password">
                  <svg class="icon icon-eye" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                  <svg class="icon icon-eye-off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                    <line x1="1" y1="1" x2="23" y2="23"></line>
                  </svg>
                </button>
              </div>
              <small class="field-error" id="matchError"></small>
            </div>

            <div class="st-form__actions">
              <button type="submit" class="btn-primary" id="requestPwBtn">Send Verification Code</button>
            </div>
          </form>
        </div>

        <!-- Step 2: confirm password change with a 6-digit code -->
        <div class="st-card" id="confirmPasswordCard" style="display:none;">
          <div class="st-card__head">
            <h3 class="st-card__title">Confirm Password Change</h3>
            <p class="st-card__sub" id="pwEmailHint">A 6-digit code was sent to your email</p>
          </div>

          <form id="passwordConfirmForm" class="st-form" novalidate>
            <input type="hidden" name="newPassword">
            <input type="hidden" name="confirmPassword">

            <div class="field">
              <label for="passwordCode">6-Digit Code</label>
              <input id="passwordCode" type="text" name="code" maxlength="6" inputmode="numeric" pattern="\d{6}" placeholder="------" autocomplete="one-time-code" class="otp-input" dir="ltr">
            </div>

            <div class="st-form__actions">
              <button type="button" class="btn-ghost" id="cancelPasswordChange">Cancel</button>
              <button type="submit" class="btn-primary" id="confirmPwBtn">Confirm and Change Password</button>
            </div>
          </form>
        </div>

        <!-- Danger zone: sign out of all devices -->
        <div class="st-card st-card--danger">
          <div class="st-card__head">
            <h3 class="st-card__title">Sign Out of All Devices</h3>
            <p class="st-card__sub">All of your active sessions will be terminated.</p>
          </div>

          <button type="button" class="btn-danger" id="logoutAllBtn">Sign Out of All Devices</button>
        </div>
      </section>
    </main>
  </div>

  <script src="/js/form-errors.js"></script>
  <script src="/js/dashboard-nav.js"></script>
  <script src="/js/components/markdown-editor.js"></script>
  <script src="/js/dashboard/settings.js"></script>
</body>

</html>