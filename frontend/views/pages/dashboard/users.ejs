<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
  <!-- Apply persisted theme and accent preferences before first paint to prevent flashing. -->
  <meta charset="UTF-8">
  <script>
    (function() {
      try {
        var mode = localStorage.getItem('dh-mode') || 'system';
        var accent = localStorage.getItem('dh-accent') || 'blue';
        var resolvedMode = mode === 'system' ?
          (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark') :
          mode;

        document.documentElement.setAttribute('data-mode', resolvedMode);
        document.documentElement.setAttribute('data-accent', accent);
        document.documentElement.style.colorScheme = resolvedMode;
      } catch (e) {}
    })();
  </script>

  <meta name="robots" content="noindex, nofollow">

  <!-- Fonts and global styles -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="/styles/index.css">
  <link rel="stylesheet" href="/styles/themes.css">

  <!-- Favicon -->
  <link rel="icon" href="/assets/logo.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/assets/logo.svg">

  <!-- Page-specific styles -->
  <link rel="stylesheet" href="/styles/dialog.css">
  <link rel="stylesheet" href="/styles/dashboard/dashboard.css">
  <link rel="stylesheet" href="/styles/dashboard/dashboard-nav.css">
  <link rel="stylesheet" href="/styles/dashboard/users.css">

  <title>User Management</title>
</head>

<body>
  <%- include("../../components/dialogError") %>

  <div class="dash-layout">
    <%- include("../../components/dashboard-nav") %>
    <%- include("../../components/dash-breadcrumb", { pageTitle: "Users" }) %>

    <main class="dash-main">
      <!-- ============ PAGE HEADER ============ -->
      <div class="dash-head">
        <div>
          <h2 class="dash-title">User Management</h2>
          <p class="dash-sub" id="usersCount">—</p>
        </div>
      </div>

      <!-- ============ FILTERS ============ -->
      <div class="dash-filters">
        <div class="dash-search">
          <input type="text" id="userSearch" placeholder="Search by name, email, or username…">
        </div>

        <select id="filterRole" class="dash-select">
          <option value="">All roles</option>
          <option value="user">User</option>
          <option value="admin">Admin</option>
          <option value="developer">Developer</option>
        </select>
      </div>

      <!-- ============ USERS TABLE ============ -->
      <div id="usersTable" class="users-table"></div>

      <!-- ============ PAGINATION ============ -->
      <div class="dash-pagination" id="usersPagination"></div>
    </main>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const $ = (selector) => document.querySelector(selector);

      /* ------------------------------------------------------------------
       * Local view state.
       * `user` holds the currently authenticated account, used to prevent
       * self-modification (role change and ban) in the table.
       * ------------------------------------------------------------------ */
      const state = {
        page: 1,
        search: '',
        role: '',
        user: null,
        isDeveloper: false
      };

      /**
       * Thin wrapper around fetch that sends credentials, parses JSON,
       * and throws an Error carrying the server payload on non-2xx responses.
       */
      async function api(path, opts = {}) {
        const res = await fetch(path, {
          credentials: 'include',
          headers: {
            'Content-Type': 'application/json'
          },
          ...opts,
        });

        const data = await res.json().catch(() => null);

        if (!res.ok) {
          throw Object.assign(new Error(data?.message || 'Error'), data);
        }

        return data;
      }

      /**
       * Fetch the authenticated user and cache their role so the UI can
       * conditionally enable developer-level actions.
       */
      async function loadCurrentUser() {
        const res = await fetch('/api/auth/me', {
          credentials: 'include'
        });

        const data = await res.json();
        state.user = data.user;
        state.isDeveloper = data.user?.role === 'developer';
      }

      /**
       * Load a page of users from the admin API and render the table.
       * Search and role filters are appended only when set.
       */
      async function load() {
        const params = new URLSearchParams({
          page: state.page,
          limit: 20
        });

        if (state.search) params.set('search', state.search);
        if (state.role) params.set('role', state.role);

        const data = await api(`/api/admin/users?${params}`);

        $('#usersCount').textContent = `${data.pagination.total} users`;

        if (!data.users.length) {
          $('#usersTable').innerHTML = `<div class="dash-empty">No users found</div>`;

          return;
        }

        $('#usersTable').innerHTML = `
          <div class="users-table__head">
            <span>User</span>
            <span>Role</span>
            <span>Date</span>
            <span>Actions</span>
          </div>
          ${data.users.map((u) => {
            const name = u.name || u.username;

            // Prevent the current user from modifying their own account.
            const isMe = String(u._id) === String(state.user.id);

            // Only developers may promote or demote developer accounts.
            const canChangeDeveloper = state.isDeveloper;

            const userLink = u.username
              ? `/users/${encodeURIComponent(u.username)}`
              : '#';

            return `
              <div class="users-table__row" data-id="${u._id}">
                <div class="users-table__user">
                  <a href="${userLink}" class="users-table__avatar" ${u.avatar?.url ? `style="background-image:url('${u.avatar.url}')"` : ''}>
                    ${!u.avatar?.url ? name.charAt(0).toUpperCase() : ''}
                  </a>
                  <div>
                    <a href="${userLink}" class="users-table__name">${escapeHtml(name)}</a>
                    <div class="users-table__email">${escapeHtml(u.email)}</div>
                  </div>
                </div>

                <select class="dash-select" data-role-select ${isMe ? 'disabled' : ''}>
                  <option value="user" ${u.role === 'user' ? 'selected' : ''}>User</option>
                  <option value="admin" ${u.role === 'admin' ? 'selected' : ''}>Admin</option>
                  <option value="developer" ${u.role === 'developer' ? 'selected' : ''}
                    ${!canChangeDeveloper ? 'disabled' : ''}>
                    Developer
                  </option>
                </select>

                <span class="users-table__date">${new Date(u.createdAt).toLocaleDateString('en-US')}</span>

                <button class="btn-ghost" data-ban ${isMe ? 'disabled' : ''}>
                  ${u.isBanned ? 'Unban' : 'Ban'}
                </button>
              </div>
            `;
          }).join('')}
        `;

        bindActions();
      }

      /**
       * Attach event handlers to the dynamically rendered table rows:
       * role change (with an optional reason prompt) and ban toggle.
       */
      function bindActions() {
        document.querySelectorAll('[data-role-select]').forEach((sel) => {
          sel.addEventListener('change', async () => {
            const row = sel.closest('.users-table__row');
            const userId = row.dataset.id;
            const newRole = sel.value;

            const reason = prompt(`Reason for changing the role to ${newRole}? (optional)`);

            // `null` means the prompt was dismissed — revert the selection.
            if (reason === null) {
              load();
              return;
            }

            try {
              await api(`/api/admin/users/${userId}/role`, {
                method: 'POST',
                body: JSON.stringify({
                  role: newRole,
                  reason: reason || undefined
                }),
              });

              toast('Role updated', 'success');
              load();
            } catch (err) {
              toast(err.message || 'Error', 'error');
              load();
            }
          });
        });

        document.querySelectorAll('[data-ban]').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const row = btn.closest('.users-table__row');
            const userId = row.dataset.id;

            try {
              const data = await api(`/api/admin/users/${userId}/ban`, {
                method: 'POST'
              });

              toast(data.message, 'success');
              load();
            } catch (err) {
              toast(err.message || 'Error', 'error');
            }
          });
        });
      }

      /**
       * Escape user-supplied strings before interpolating them into HTML
       * to prevent markup injection.
       */
      function escapeHtml(s) {
        if (s == null) return '';

        return String(s)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      /* ------------------------------------------------------------------
       * Filter bindings — search is debounced to avoid excessive requests.
       * ------------------------------------------------------------------ */
      let timer;

      $('#userSearch').addEventListener('input', (e) => {
        clearTimeout(timer);
        timer = setTimeout(() => {
          state.search = e.target.value.trim();
          state.page = 1;
          load();
        }, 350);
      });

      $('#filterRole').addEventListener('change', (e) => {
        state.role = e.target.value;
        state.page = 1;
        load();
      });

      // Bootstrap: resolve the current user first, then load the table.
      (async () => {
        await loadCurrentUser();
        await load();
      })();
    });
  </script>
</body>

<script src="/js/dashboard-nav.js"></script>

</html>