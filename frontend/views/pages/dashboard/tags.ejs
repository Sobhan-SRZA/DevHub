<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
  <!-- Apply persisted theme and accent preferences before first paint to prevent flashing. -->
  <meta charset="UTF-8">
  <script>
    (function() {
      try {
        var mode = localStorage.getItem('dh-mode') || 'system';
        var accent = localStorage.getItem('dh-accent') || 'blue';
        var resolvedMode = mode === 'system' ?
          (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark') :
          mode;

        document.documentElement.setAttribute('data-mode', resolvedMode);
        document.documentElement.setAttribute('data-accent', accent);
        document.documentElement.style.colorScheme = resolvedMode;
      } catch (e) {}
    })();
  </script>

  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">

  <!-- Fonts and global styles -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="/styles/index.css">
  <link rel="stylesheet" href="/styles/themes.css">

  <!-- Favicon -->
  <link rel="icon" href="/assets/logo.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/assets/logo.svg">

  <!-- Page-specific styles -->
  <link rel="stylesheet" href="/styles/dialog.css">
  <link rel="stylesheet" href="/styles/form-errors.css">
  <link rel="stylesheet" href="/styles/dashboard/dashboard.css">
  <link rel="stylesheet" href="/styles/dashboard/dashboard-nav.css">

  <title>Tags</title>
</head>

<body>
  <%- include("../../components/dialogError") %>

  <div class="dash-layout">
    <%- include("../../components/dashboard-nav") %>
    <%- include("../../components/dash-breadcrumb", { pageTitle: "Tags" }) %>

    <main class="dash-main">
      <!-- ============ PAGE HEADER ============ -->
      <div class="dash-head">
        <div>
          <h2 class="dash-title">Tag Management</h2>
          <p class="dash-sub" id="tagsCount">—</p>
        </div>

        <button type="button" class="btn-primary" id="btnNewTag">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          New Tag
        </button>
      </div>

      <!-- ============ FILTERS ============ -->
      <div class="dash-filters">
        <div class="dash-search">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" id="tagSearch" placeholder="Search tags...">
        </div>

        <select id="tagFilterType" class="dash-select">
          <option value="">All types</option>
        </select>

        <select id="tagSort" class="dash-select">
          <option value="usage">Most used</option>
          <option value="name">By name</option>
          <option value="recent">Newest</option>
        </select>
      </div>

      <!-- ============ TAG LIST ============ -->
      <div class="tag-list" id="tagsList">
        <div class="dash-loading">Loading…</div>
      </div>

      <!-- ============ PAGINATION ============ -->
      <div class="dash-pagination" id="tagsPagination"></div>
    </main>
  </div>

  <!-- ================================================================
       TAG MODAL (CREATE / EDIT)
       Used to create or edit a tag with name, type, color, and an
       optional description.
       ================================================================ -->
  <div class="modal-backdrop" id="tagModalBackdrop"></div>
  <div class="modal modal--sm" id="tagModal" role="dialog">
    <div class="modal__header">
      <h3 class="modal__title" id="tagModalTitle">New Tag</h3>

      <button type="button" class="modal__close" id="tagModalClose">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <form class="modal__body" id="tagForm" novalidate>
      <input type="hidden" name="_id">

      <div class="field">
        <label for="t-name">Tag Name <span class="req">*</span></label>
        <input id="t-name" type="text" name="name" required maxlength="40" placeholder="React">
      </div>

      <div class="field">
        <label for="t-type">Tag Type <span class="req">*</span></label>
        <select id="t-type" name="type" required></select>
      </div>

      <div class="field">
        <label for="t-color">Color</label>
        <input id="t-color" type="color" name="color" value="#6ebbff">
      </div>

      <div class="field">
        <label for="t-description">Description <small>(optional)</small></label>
        <textarea id="t-description" name="description" rows="2" maxlength="200"></textarea>
      </div>
    </form>

    <div class="modal__footer">
      <button type="button" class="btn-ghost" id="tagModalCancel">Cancel</button>
      <button type="submit" form="tagForm" class="btn-primary" id="tagModalSubmit">Save</button>
    </div>
  </div>

  <script src="/js/form-errors.js"></script>
  <script src="/js/dashboard-nav.js"></script>
  <script src="/js/dashboard/tags.js"></script>
</body>

</html>