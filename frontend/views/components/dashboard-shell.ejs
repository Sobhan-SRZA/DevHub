<%
  /**
   * Dashboard shell component.
   * Wraps dashboard page content with the sidebar, breadcrumb, and main content area.
   * Does not include the global header by design.
   *
   * Usage inside a dashboard page (after <body>):
   *
   *   <%- include("../components/dashboard-shell", { pageTitle: "Overview" }) %>
* ... your page content ...
* </main>
</div>
</div> <!-- Close the shell manually, or use the close partial. -->
*
* Recommended: use the open and close partials.
*/
const _pageTitle = typeof pageTitle !== "undefined" ? pageTitle : "Dashboard";
%>

<div class="dash-layout flex min-h-screen bg-surface text-content" id="dashLayout">
  <%- include("./dashboard-nav") %>

  <div class="dash-content flex-1 flex flex-col min-w-0 relative">
    <%- include("./dash-breadcrumb", { pageTitle: _pageTitle }) %>

    <main class="dash-main flex-1 w-full max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-6">