<%
  const year = new Date().getFullYear();
%>
<footer class="site-footer" role="contentinfo">
  <div class="site-footer__inner">

    <!-- ============ GRID ============ -->
    <div class="site-footer__grid">

      <!-- Brand column -->
      <div class="site-footer__brand">
        <%- include("./brand", {
          brandGradientId: "brandFooter",
          brandSize: 32,
          brandShowText: true
        }) %>

        <p class="site-footer__tagline">
          A platform to discover, review, and share open-source projects
          — built for developers around the world.
        </p>

        <div class="site-footer__socials">
          <a href="https://github.com/Sobhan-SRZA/devhub" target="_blank" rel="noopener noreferrer" class="site-footer__social" aria-label="View DevHub on GitHub">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.387.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.73.083-.73 1.205.085 1.84 1.237 1.84 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.775.418-1.305.762-1.605-2.665-.305-5.467-1.334-5.467-5.93 0-1.31.468-2.38 1.235-3.22-.123-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.3 1.23.96-.267 1.98-.4 3-.405 1.02.005 2.04.138 3 .405 2.29-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.12 3.176.77.84 1.233 1.91 1.233 3.22 0 4.61-2.807 5.62-5.48 5.92.43.37.823 1.102.823 2.222 0 1.606-.015 2.896-.015 3.286 0 .32.217.694.825.576C20.565 21.796 24 17.3 24 12c0-6.63-5.37-12-12-12z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Product column -->
      <div class="site-footer__column">
        <h3 class="site-footer__heading">Product</h3>
        <ul class="site-footer__list">
          <li><a href="/explore" class="site-footer__link">Explore</a></li>
          <li><a href="/projects" class="site-footer__link">Projects</a></li>
          <li><a href="/users" class="site-footer__link">Users</a></li>
          <li><a href="/dashboard" class="site-footer__link">Dashboard</a></li>
        </ul>
      </div>

      <!-- Company column -->
      <div class="site-footer__column">
        <h3 class="site-footer__heading">Company</h3>
        <ul class="site-footer__list">
          <li><a href="/about" class="site-footer__link">About Us</a></li>
          <li><a href="/contact" class="site-footer__link">Contact Us</a></li>
        </ul>
      </div>

      <!-- Account column -->
      <div class="site-footer__column">
        <h3 class="site-footer__heading">Account</h3>
        <ul class="site-footer__list">
          <li><a href="/auth/login" class="site-footer__link">Log In</a></li>
          <li><a href="/auth/register" class="site-footer__link">Sign Up</a></li>
        </ul>
      </div>

      <!-- Legal column -->
      <div class="site-footer__column">
        <h3 class="site-footer__heading">Legal</h3>
        <ul class="site-footer__list">
          <li><a href="/legal/privacy" class="site-footer__link">Privacy Policy</a></li>
          <li><a href="/legal/terms" class="site-footer__link">Terms of Service</a></li>
        </ul>
      </div>

    </div>

    <!-- ============ BOTTOM ROW ============ -->
    <div class="site-footer__bottom">
      <p class="site-footer__copyright">
        © <%= year %> DevHub. All rights reserved.
      </p>

      <p class="site-footer__made-with">
        Made with <span class="site-footer__heart" aria-hidden="true">♥</span>
        for the open-source community
      </p>
    </div>

  </div>
</footer>