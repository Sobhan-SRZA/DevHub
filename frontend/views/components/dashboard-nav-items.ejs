<%
    /**
     * Shared dashboard navigation items
     * Props:
     * - variant: 'sidebar' | 'drawer' | 'menu'
     */
    const _variant = (typeof variant !== 'undefined') ? variant : 'sidebar';
    const _isDrawer = _variant === 'drawer';
    const _isMenu = _variant === 'menu';

    const _itemClass  = _isMenu ? 'dash-menu__item' : (_isDrawer ? 'h-drawer__link' : 'dash-nav__item');
    const _sectionCls = _isMenu ? 'dash-menu__section' : (_isDrawer ? 'h-drawer__section' : 'dash-nav__section');
    const _labelCls   = _isMenu ? 'dash-menu__section-label' : (_isDrawer ? 'h-drawer__section-label' : 'dash-nav__section-label');
    const _dividerCls = _isMenu ? 'dash-menu__divider' : (_isDrawer ? 'h-drawer__divider' : 'dash-nav__divider');
    const _emojiCls   = _isMenu ? 'dash-menu__section-emoji' : (_isDrawer ? 'h-drawer__section-emoji' : 'dash-nav__section-emoji');

    // Role detection
    const _cu = (locals && locals.currentUser) || (typeof user !== 'undefined' ? user : null);
    const _role = (locals && locals.userRole) || (_cu && _cu.role) || 'user';
    const _isAdmin = (locals && typeof locals.isAdmin === 'boolean') ? locals.isAdmin : ['admin', 'developer'].includes(_role);
    const _isDev   = (locals && typeof locals.isDeveloper === 'boolean') ? locals.isDeveloper : _role === 'developer';
%>

<div class="<%= _sectionCls %>">
  <div class="<%= _labelCls %>">داشبورد</div>

  <a href="/dashboard" class="<%= _itemClass %>" data-nav="/dashboard" data-exact title="نمای کلی">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="3" width="7" height="7"></rect>
      <rect x="14" y="3" width="7" height="7"></rect>
      <rect x="14" y="14" width="7" height="7"></rect>
      <rect x="3" y="14" width="7" height="7"></rect>
    </svg>
    <span>نمای کلی</span>
  </a>

  <a href="/dashboard/projects" class="<%= _itemClass %>" data-nav="/dashboard/projects" title="پروژه‌های من">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
      <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
    </svg>
    <span>پروژه‌های من</span>
  </a>

  <a href="/dashboard/profile" class="<%= _itemClass %>" data-nav="/dashboard/profile" data-exact title="پروفایل من">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
      <circle cx="12" cy="7" r="4"></circle>
    </svg>
    <span>پروفایل من</span>
  </a>

  <a href="/dashboard/profile/settings" class="<%= _itemClass %>" data-nav="/dashboard/profile/settings" title="تنظیمات">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="3"></circle>
      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
    </svg>
    <span>تنظیمات</span>
  </a>
</div>

<% if (_isAdmin) { %>
<div class="<%= _dividerCls %>"></div>

<div class="<%= _sectionCls %>">
  <div class="<%= _labelCls %>">
    <span class="<%= _emojiCls %>">👑</span>
    مدیریت
  </div>

  <a href="/dashboard/users" class="<%= _itemClass %>" data-nav="/dashboard/users" title="کاربران">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
      <circle cx="9" cy="7" r="4"></circle>
      <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
      <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
    </svg>
    <span>کاربران</span>
  </a>

  <a href="/dashboard/tags" class="<%= _itemClass %>" data-nav="/dashboard/tags" title="تگ‌ها">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
      <line x1="7" y1="7" x2="7.01" y2="7"></line>
    </svg>
    <span>تگ‌ها</span>
  </a>

  <a href="/dashboard/tag-types" class="<%= _itemClass %>" data-nav="/dashboard/tag-types" title="نوع تگ‌ها">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="8" y1="6" x2="21" y2="6"></line>
      <line x1="8" y1="12" x2="21" y2="12"></line>
      <line x1="8" y1="18" x2="21" y2="18"></line>
      <line x1="3" y1="6" x2="3.01" y2="6"></line>
      <line x1="3" y1="12" x2="3.01" y2="12"></line>
      <line x1="3" y1="18" x2="3.01" y2="18"></line>
    </svg>
    <span>نوع تگ‌ها</span>
  </a>
</div>
<% } %>

<% if (_isDev) { %>
<div class="<%= _dividerCls %>"></div>

<div class="<%= _sectionCls %>">
  <div class="<%= _labelCls %>">
    <span class="<%= _emojiCls %>">⚡</span>
    دولوپر
  </div>

  <a href="/dashboard/system" class="<%= _itemClass %>" data-nav="/dashboard/system" title="وضعیت سیستم">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
      <line x1="8" y1="21" x2="16" y2="21"></line>
      <line x1="12" y1="17" x2="12" y2="21"></line>
    </svg>
    <span>وضعیت سیستم</span>
  </a>

  <a href="/dashboard/logs" class="<%= _itemClass %>" data-nav="/dashboard/logs" title="لاگ‌ها">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
      <polyline points="14 2 14 8 20 8"></polyline>
      <line x1="16" y1="13" x2="8" y2="13"></line>
      <line x1="16" y1="17" x2="8" y2="17"></line>
    </svg>
    <span>لاگ‌ها</span>
  </a>
</div>
<% } %>