<link rel="stylesheet" href="/styles/header.css">

<%
    const cu = (locals && locals.currentUser) || null;
    const role = (locals && locals.userRole) || cu?.role || 'user';
    const isAdmin = (locals && locals.isAdmin) || ['admin', 'developer'].includes(role);
    const isDeveloper = (locals && locals.isDeveloper) || role === 'developer';
    const isLoggedIn = !!cu;
    const inDashboard = typeof currentPath !== 'undefined' && currentPath.startsWith('/dashboard');
%>

<header class="header" id="mainHeader" dir="rtl">
  <div class="header__inner">

    <!-- Mobile menu button -->
    <button type="button" class="h-mobile-btn" id="mobileMenuBtn" aria-label="منو" aria-expanded="false">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <!-- Logo -->
    <a href="/" class="h-logo" aria-label="خانه">
      <svg width="64" height="64" viewBox="7 7 50 50" xmlns="http://www.w3.org/2000/svg" class="h-logo__icon-svg">
        <defs>
          <linearGradient id="logoGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#007bff"></stop>
            <stop offset="100%" stop-color="#6ebbff"></stop>
          </linearGradient>
        </defs>
        <g stroke="#6ebbff" stroke-width="2.5" opacity="0.5">
          <line x1="32" y1="32" x2="32" y2="12"></line>
          <line x1="32" y1="32" x2="32" y2="52"></line>
          <line x1="32" y1="32" x2="12" y2="32"></line>
          <line x1="32" y1="32" x2="52" y2="32"></line>
        </g>
        <circle cx="32" cy="12" r="4" fill="#6ebbff"></circle>
        <circle cx="32" cy="52" r="4" fill="#6ebbff"></circle>
        <circle cx="12" cy="32" r="4" fill="#6ebbff"></circle>
        <circle cx="52" cy="32" r="4" fill="#6ebbff"></circle>
        <circle cx="32" cy="32" r="12" fill="url(#logoGrad2)"></circle>
        <text x="32" y="35" text-anchor="middle" fill="#fff" font-size="11" font-weight="bold" font-family="monospace">&lt;/&gt;</text>
      </svg>
      <span class="h-logo__text">DevHub</span>
    </a>

    <!-- Desktop nav -->
    <nav class="h-nav" aria-label="ناوبری اصلی">
      <ul class="h-nav__list">
        <li><a href="/" class="h-nav__link">خانه</a></li>
        <li><a href="/explore" class="h-nav__link">اکسپلور</a></li>
        <li><a href="/projects" class="h-nav__link">پروژه‌ها</a></li>
        <li><a href="/users" class="h-nav__link">کاربران</a></li>
        <li><a href="/about" class="h-nav__link">درباره</a></li>
      </ul>
    </nav>

    <!-- Actions -->
    <div class="h-actions">
      <button type="button" class="h-icon-btn" id="searchBtn" aria-label="جستجو" title="جستجو (Ctrl+K)">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <button type="button" class="h-icon-btn h-notif-btn" id="notifBtn" aria-label="اعلان‌ها" data-coming-soon="اعلان‌ها">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
        <span class="h-notif-dot" id="notifDot" style="display:none;"></span>
      </button>

      <!-- Auth -->
      <div class="auth-area" id="authArea">
        <div class="auth-guests" id="authGuests" style="visibility: hidden;">
          <a href="/auth/login" class="nav-btn nav-btn-outline">ورود</a>
          <a href="/auth/register" class="nav-btn nav-btn-primary">ثبت نام</a>
        </div>

        <div class="auth-profile" id="authProfile" style="display: none;">
          <button type="button" class="profile-btn" id="profileBtn" aria-haspopup="true" aria-expanded="false">
            <span class="profile-avatar" id="profileAvatar"><span id="profileInitial">U</span></span>
            <span class="profile-name" id="profileName">کاربر</span>
            <svg class="profile-caret" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <div class="profile-menu" id="profileMenu" role="menu">
            <div class="profile-menu__header">
              <span class="profile-menu__avatar" id="menuAvatar"></span>
              <div class="profile-menu__info">
                <span class="profile-menu__name" id="menuName">کاربر</span>
                <span class="profile-menu__username" id="menuUsername">@—</span>
              </div>
            </div>
            <div class="profile-menu__divider"></div>
            <a href="#" class="profile-menu-item" id="menuProfileLink" role="menuitem">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              پروفایل من
            </a>
            <a href="/dashboard" class="profile-menu-item" role="menuitem">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
              داشبورد
            </a>
            <a href="/dashboard/profile/settings" class="profile-menu-item" role="menuitem">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
              </svg>
              تنظیمات
            </a>
            <div class="profile-menu__divider"></div>
            <button type="button" class="profile-menu-item logout" id="logoutBtn" role="menuitem">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
              </svg>
              خروج
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- ============================================ -->
<!-- SEARCH MODAL                                  -->
<!-- ============================================ -->
<div class="h-search" id="searchOverlay" aria-hidden="true">
  <div class="h-search__backdrop" data-close-search></div>
  <div class="h-search__dialog" role="dialog" aria-label="جستجو">
    <div class="h-search__input-wrap">
      <svg class="h-search__icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" id="searchInput" class="h-search__input" placeholder="جستجو در پروژه‌ها، کاربران، تگ‌ها..." autocomplete="off">
      <button class="h-search__close" data-close-search aria-label="بستن"><kbd>ESC</kbd></button>
    </div>
    <div class="h-search__suggestions">
      <div class="h-search__suggestions-title">دسترسی سریع</div>
      <a href="/explore" class="h-search__suggest">
        <span class="h-search__suggest-icon" style="--c:#6ebbff">🔥</span>
        <span>اکسپلور پروژه‌ها</span>
      </a>
      <a href="/projects" class="h-search__suggest">
        <span class="h-search__suggest-icon" style="--c:#34d399">📦</span>
        <span>همه پروژه‌ها</span>
      </a>
      <a href="/users" class="h-search__suggest">
        <span class="h-search__suggest-icon" style="--c:#a78bfa">👥</span>
        <span>کاربران</span>
      </a>
    </div>
  </div>
</div>

<!-- ============================================ -->
<!-- UNIFIED MOBILE DRAWER (site + dashboard)     -->
<!-- ============================================ -->
<div class="h-drawer" id="mobileDrawer" aria-hidden="true">
  <div class="h-drawer__backdrop" data-close-drawer></div>
  <aside class="h-drawer__panel" role="dialog" aria-label="منو">

    <div class="h-drawer__header">
      <a href="/" class="h-logo">
        <svg width="64" height="64" viewBox="7 7 50 50" xmlns="http://www.w3.org/2000/svg" class="h-logo__icon-svg">
          <defs>
            <linearGradient id="logoGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#007bff"></stop>
              <stop offset="100%" stop-color="#6ebbff"></stop>
            </linearGradient>
          </defs>
          <g stroke="#6ebbff" stroke-width="2.5" opacity="0.5">
            <line x1="32" y1="32" x2="32" y2="12"></line>
            <line x1="32" y1="32" x2="32" y2="52"></line>
            <line x1="32" y1="32" x2="12" y2="32"></line>
            <line x1="32" y1="32" x2="52" y2="32"></line>
          </g>
          <circle cx="32" cy="12" r="4" fill="#6ebbff"></circle>
          <circle cx="32" cy="52" r="4" fill="#6ebbff"></circle>
          <circle cx="12" cy="32" r="4" fill="#6ebbff"></circle>
          <circle cx="52" cy="32" r="4" fill="#6ebbff"></circle>
          <circle cx="32" cy="32" r="12" fill="url(#logoGrad2)"></circle>
          <text x="32" y="35" text-anchor="middle" fill="#fff" font-size="11" font-weight="bold" font-family="monospace">&lt;/&gt;</text>
        </svg>
        <span class="h-logo__text">DevHub</span>
      </a>
      <button type="button" class="h-drawer__close" data-close-drawer aria-label="بستن">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Profile (if logged in) -->
    <div class="h-drawer__profile" id="drawerProfile" style="display:none;">
      <span class="h-drawer__avatar" id="drawerAvatar"></span>
      <div class="h-drawer__profile-info">
        <strong id="drawerName">کاربر</strong>
        <small id="drawerUsername">@—</small>
      </div>
    </div>

    <nav class="h-drawer__nav" id="drawerNav">

      <!-- ========================================== -->
      <!-- DASHBOARD SECTION (اگر لاگین و در داشبورد) -->
      <!-- ========================================== -->
      <div class="h-drawer__section h-drawer__section--dashboard" id="drawerDashboardSection" style="display:none;">

        <div class="h-drawer__section-label">داشبورد</div>

        <a href="/dashboard" class="h-drawer__link">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          نمای کلی
        </a>

        <a href="/dashboard/projects" class="h-drawer__link">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
          </svg>
          پروژه‌های من
        </a>

        <a href="/dashboard/profile" class="h-drawer__link">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          پروفایل
        </a>

        <a href="/dashboard/profile/settings" class="h-drawer__link">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
          </svg>
          تنظیمات
        </a>

        <% if (isAdmin) { %>
        <a href="/dashboard/users" class="h-drawer__link">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
          کاربران
        </a>
        <a href="/dashboard/tags" class="h-drawer__link">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
            <line x1="7" y1="7" x2="7.01" y2="7"></line>
          </svg>
          تگ‌ها
        </a>
        <a href="/dashboard/tag-types" class="h-drawer__link">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="8" y1="6" x2="21" y2="6"></line>
            <line x1="8" y1="12" x2="21" y2="12"></line>
            <line x1="8" y1="18" x2="21" y2="18"></line>
            <line x1="3" y1="6" x2="3.01" y2="6"></line>
            <line x1="3" y1="12" x2="3.01" y2="12"></line>
            <line x1="3" y1="18" x2="3.01" y2="18"></line>
          </svg>
          نوع تگ‌ها
        </a>
        <% } %>

        <% if (isDeveloper) { %>
        <a href="/dashboard/system" class="h-drawer__link">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
          وضعیت سیستم
        </a>
        <a href="/dashboard/logs" class="h-drawer__link">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
          </svg>
          لاگ‌ها
        </a>
        <% } %>
      </div>

      <!-- ========================================== -->
      <!-- MAIN SITE SECTION                          -->
      <!-- ========================================== -->
      <div class="h-drawer__section h-drawer__section--main">

        <div class="h-drawer__section-label">سایت</div>

        <a href="/" class="h-drawer__link">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          خانه
        </a>
        <a href="/explore" class="h-drawer__link">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          اکسپلور
        </a>
        <a href="/projects" class="h-drawer__link">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
          </svg>
          پروژه‌ها
        </a>
        <a href="/users" class="h-drawer__link">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
          کاربران
        </a>
        <a href="/about" class="h-drawer__link">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
          درباره ما
        </a>
        <a href="/contact" class="h-drawer__link">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
          تماس با ما
        </a>
      </div>
    </nav>

    <div class="h-drawer__footer">
      <div class="auth-guests" id="drawerGuests" style="visibility: hidden;">
        <a href="/auth/login" class="nav-btn nav-btn-outline">ورود</a>
        <a href="/auth/register" class="nav-btn nav-btn-primary">ثبت نام</a>
      </div>
      <button type="button" class="h-drawer__logout" id="drawerLogout" style="display:none;">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
