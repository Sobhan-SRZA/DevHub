<link rel="stylesheet" href="/styles/header.css">

<header class="header" id="mainHeader" dir="ltr">
  <div class="header__inner">

    <!-- Mobile Navigation Toggle -->
    <button type="button" class="h-mobile-btn" id="mobileMenuBtn" aria-label="Open navigation menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <!-- Brand Identity -->
    <%- include("./brand", {
            brandGradientId: "brandHeader",
            brandSize: 36,
            brandShowText: true
        }) %>

    <!-- Primary Desktop Navigation -->
    <nav class="h-nav" aria-label="Main navigation">
      <ul class="h-nav__list">
        <li><a href="/" class="h-nav__link">Home</a></li>
        <li><a href="/explore" class="h-nav__link">Explore</a></li>
        <li><a href="/projects" class="h-nav__link">Projects</a></li>
        <li><a href="/users" class="h-nav__link">Users</a></li>
        <li><a href="/about" class="h-nav__link">About</a></li>
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="h-actions">

      <!-- Global Search -->
      <button type="button" class="h-icon-btn" id="searchBtn" aria-label="Search" title="Search (Ctrl+K)">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <!-- Appearance and Theme Controls -->
      <%- include("./theme-switcher") %>

      <!-- Notifications -->
      <button type="button" class="h-icon-btn h-notif-btn" id="notifBtn" aria-label="Notifications">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
        <span class="h-notif-dot" id="notifDot" style="display: none;"></span>
      </button>

      <!-- Desktop Dashboard Shortcut (Visible to Authenticated Users) -->
      <a href="/dashboard" class="h-icon-btn h-dash-btn" id="dashShortcut" aria-label="Dashboard" title="Dashboard" style="display: none;">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
      </a>

      <!-- Authentication and User Profile -->
      <div class="auth-area" id="authArea">

        <!-- Guest Actions -->
        <div class="auth-guests" id="authGuests" style="visibility: hidden;">
          <a href="/auth/login" class="nav-btn nav-btn-outline">Log In</a>
          <a href="/auth/register" class="nav-btn nav-btn-primary">Sign Up</a>
        </div>

        <!-- Authenticated User Profile -->
        <div class="auth-profile" id="authProfile" style="display: none;">
          <button type="button" class="profile-btn" id="profileBtn" aria-haspopup="true" aria-expanded="false">
            <span class="profile-avatar" id="profileAvatar">
              <span id="profileInitial">U</span>
            </span>

            <span class="profile-name" id="profileName">User</span>

            <svg class="profile-caret" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <!-- User Profile Dropdown -->
          <div class="profile-menu" id="profileMenu" role="menu">
            <div class="profile-menu__header">
              <span class="profile-menu__avatar" id="menuAvatar"></span>

              <div class="profile-menu__info">
                <span class="profile-menu__name" id="menuName">User</span>
                <span class="profile-menu__username" id="menuUsername">@—</span>
              </div>
            </div>

            <div class="profile-menu__divider"></div>

            <!-- Dashboard -->
            <a href="/dashboard" class="profile-menu-item profile-menu-item--primary" role="menuitem">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
              Dashboard
            </a>

            <!-- Public User Profile -->
            <a href="#" class="profile-menu-item" id="menuProfileLink" role="menuitem">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              My Profile
            </a>

            <!-- Account Settings -->
            <a href="/dashboard/settings" class="profile-menu-item" role="menuitem">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
              </svg>
              Settings
            </a>

            <div class="profile-menu__divider"></div>

            <!-- Sign Out -->
            <button type="button" class="profile-menu-item logout" id="logoutBtn" role="menuitem">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
              </svg>
              Log Out
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Global Search Dialog -->
<%- include("./search-modal") %>

<!-- Mobile Navigation Drawer -->
<%- include("./mobile-drawer") %>

<script src="/js/header.js"></script>
<script src="/js/theme.js"></script>
<script src="/js/components/user-chip.js"></script>