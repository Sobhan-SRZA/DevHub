<%
    const currentUser = (locals && locals.currentUser) || (typeof user !== 'undefined' ? user : null);
    const userRole = (locals && locals.userRole) || currentUser?.role || 'user';
    const isAdmin = (locals && typeof locals.isAdmin === 'boolean') ? locals.isAdmin : ['admin', 'developer'].includes(userRole);
    const isDeveloper = (locals && typeof locals.isDeveloper === 'boolean') ? locals.isDeveloper : userRole === 'developer';
    const displayName = currentUser?.name || currentUser?.username || 'کاربر';
    const initial = displayName.trim().charAt(0).toUpperCase();
    const hasAvatar = !!currentUser?.avatar?.url;
    const avatarStyle = hasAvatar ? `background-image:url('${currentUser.avatar.url}');background-size:cover;background-position:center;` : '';
    const roleMeta = {
        user:      { label: 'کاربر',  emoji: '👤', color: '#6ebbff' },
        admin:     { label: 'ادمین',  emoji: '👑', color: '#fbbf24' },
        developer: { label: 'دولوپر', emoji: '⚡', color: '#ec4899' },
    };
    const meta = roleMeta[userRole] || roleMeta.user;
%>

<aside class="dash-sidebar" id="dashSidebar" data-role-color="<%= meta.color %>">

  <!-- Brand + collapse toggle -->
  <div class="dash-brand">
    <span class="dash-brand__icon">
      <svg width="64" height="64" viewBox="7 7 50 50" xmlns="http://www.w3.org/2000/svg" class="h-logo__icon-svg">
        <defs>
          <linearGradient id="logoGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#007bff"></stop>
            <stop offset="100%" stop-color="#6ebbff"></stop>
          </linearGradient>
        </defs>
        <g stroke="#6ebbff" stroke-width="2.5" opacity="0.5">
          <line x1="32" y1="32" x2="32" y2="12"></line>
          <line x1="32" y1="32" x2="32" y2="52"></line>
          <line x1="32" y1="32" x2="12" y2="32"></line>
          <line x1="32" y1="32" x2="52" y2="32"></line>
        </g>
        <circle cx="32" cy="12" r="4" fill="#6ebbff"></circle>
        <circle cx="32" cy="52" r="4" fill="#6ebbff"></circle>
        <circle cx="12" cy="32" r="4" fill="#6ebbff"></circle>
        <circle cx="52" cy="32" r="4" fill="#6ebbff"></circle>
        <circle cx="32" cy="32" r="12" fill="url(#logoGrad2)"></circle>
        <text x="32" y="35" text-anchor="middle" fill="#fff" font-size="11" font-weight="bold" font-family="monospace">&lt;/&gt;</text>
      </svg>
    </span>
    <span class="dash-brand__name">داشبورد</span>

    <!-- Collapse toggle (desktop only) -->
    <button type="button" class="dash-collapse-btn" id="dashCollapseBtn" aria-label="جمع کردن منو" title="جمع کردن منو (Ctrl+B)">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
  </div>

  <!-- User card -->
  <% if (currentUser) { %>
  <div class="dash-user-card" style="--role-color: <%= meta.color %>">
    <div class="dash-user-card__avatar" style="<%= avatarStyle %>" title="<%= displayName %>">
      <% if (!hasAvatar) { %><%= initial %><% } %>
    </div>
    <div class="dash-user-card__info">
      <div class="dash-user-card__name"><%= displayName %></div>
      <span class="dash-user-card__role">
        <span class="dash-user-card__role-emoji"><%= meta.emoji %></span>
        <%= meta.label %>
      </span>
    </div>
  </div>
  <% } %>

  <!-- Navigation -->
  <nav class="dash-nav">

    <div class="dash-nav__section">
      <div class="dash-nav__section-label">منوی اصلی</div>

      <a href="/dashboard" class="dash-nav__item" data-path="/dashboard" title="نمای کلی">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        <span>نمای کلی</span>
      </a>

      <a href="/dashboard/projects" class="dash-nav__item" data-path="/dashboard/projects" title="پروژه‌های من">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
        </svg>
        <span>پروژه‌های من</span>
      </a>
    </div>

    <% if (isAdmin) { %>
    <div class="dash-nav__divider"></div>
    <div class="dash-nav__section">
      <div class="dash-nav__section-label">
        <span class="dash-nav__section-emoji">👑</span>
        مدیریت
      </div>

      <a href="/dashboard/users" class="dash-nav__item" data-path="/dashboard/users" title="کاربران">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
        <span>کاربران</span>
        <span class="dash-nav__badge" id="navUsersBadge"></span>
      </a>

      <a href="/dashboard/tags" class="dash-nav__item" data-path="/dashboard/tags" title="تگ‌ها">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
          <line x1="7" y1="7" x2="7.01" y2="7"></line>
        </svg>
        <span>تگ‌ها</span>
      </a>

      <a href="/dashboard/tag-types" class="dash-nav__item" data-path="/dashboard/tag-types" title="نوع تگ‌ها">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="8" y1="6" x2="21" y2="6"></line>
          <line x1="8" y1="12" x2="21" y2="12"></line>
          <line x1="8" y1="18" x2="21" y2="18"></line>
          <line x1="3" y1="6" x2="3.01" y2="6"></line>
          <line x1="3" y1="12" x2="3.01" y2="12"></line>
          <line x1="3" y1="18" x2="3.01" y2="18"></line>
        </svg>
        <span>نوع تگ‌ها</span>
      </a>
    </div>
    <% } %>

    <% if (isDeveloper) { %>
    <div class="dash-nav__divider"></div>
    <div class="dash-nav__section">
      <div class="dash-nav__section-label">
        <span class="dash-nav__section-emoji">⚡</span>
        دولوپر
      </div>

      <a href="/dashboard/system" class="dash-nav__item" data-path="/dashboard/system" title="وضعیت سیستم">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
          <line x1="8" y1="21" x2="16" y2="21"></line>
          <line x1="12" y1="17" x2="12" y2="21"></line>
        </svg>
        <span>وضعیت سیستم</span>
      </a>

      <a href="/dashboard/logs" class="dash-nav__item" data-path="/dashboard/logs" title="لاگ‌ها">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
        </svg>
        <span>لاگ‌ها</span>
      </a>
    </div>
    <% } %>

    <div class="dash-nav__divider"></div>
    <div class="dash-nav__section">
      <div class="dash-nav__section-label">حساب</div>

      <a href="/dashboard/profile/settings" class="dash-nav__item" data-path="/dashboard/profile/settings" title="تنظیمات">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
        <span>تنظیمات</span>
      </a>

      <a href="/" class="dash-nav__item" data-path="/" title="صفحه اصلی">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        <span>صفحه اصلی</span>
      </a>
    </div>
  </nav>

  <div class="dash-sidebar__footer">
    <button type="button" class="dash-logout-btn" id="dashLogoutBtn" title="خروج">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
        <polyline points="16 17 21 12 16 7"></polyline>
        <line x1="21" y1="12" x2="9" y2="12"></line>
      </svg>
      <span>خروج</span>
    </button>
  </div>
</aside>