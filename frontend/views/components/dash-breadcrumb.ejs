<%
  /**
   * Interactive dashboard breadcrumb with a dropdown menu.
   * Props:
   * - pageTitle (string): The current page title, e.g., "My Projects".
   * - showIcon (boolean): Whether to display the icon next to the title (default: true).
   */
  const _pageTitle = (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : '';
  const _showIcon = (typeof showIcon !== 'undefined') ? showIcon : true;
%>

<div class="dash-topbar">
  <nav class="dash-breadcrumb" aria-label="Breadcrumb">

    <div class="dash-breadcrumb__nav" id="dashBreadcrumbNav">
      <button type="button" class="dash-breadcrumb__btn" id="dashBreadcrumbBtn" aria-haspopup="menu" aria-expanded="false" aria-controls="dashBreadcrumbMenu" aria-label="Open dashboard menu">
        <svg class="dash-breadcrumb__icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        <span>Dashboard</span>
        <svg class="dash-breadcrumb__caret" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>

      <div class="dash-breadcrumb__menu" id="dashBreadcrumbMenu" role="menu">
        <%- include("./dashboard-nav-items", { variant: "menu" }) %>
      </div>
    </div>

    <% if (_pageTitle) { %>
    <span class="dash-breadcrumb__sep" aria-hidden="true">/</span>
    <span class="dash-breadcrumb__current" aria-current="page"><%= _pageTitle %></span>
    <% } %>
  </nav>
</div>