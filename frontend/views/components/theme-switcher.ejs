<div class="theme-wrap">
  <button type="button"
          class="h-icon-btn"
          id="themeBtn"
          aria-label="انتخاب تم"
          aria-haspopup="true"
          aria-expanded="false"
          title="تم ظاهری">
    <!-- Moon (shown in light mode → click to go dark context) -->
    <svg data-icon="moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
    <!-- Sun (shown in dark mode) -->
    <svg data-icon="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="5"></circle>
      <line x1="12" y1="1" x2="12" y2="3"></line>
      <line x1="12" y1="21" x2="12" y2="23"></line>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
      <line x1="1" y1="12" x2="3" y2="12"></line>
      <line x1="21" y1="12" x2="23" y2="12"></line>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
    </svg>
  </button>

  <div class="theme-panel" id="themePanel" role="dialog" aria-label="تنظیمات تم">
    <div class="theme-panel__section">
      <p class="theme-panel__title">حالت نمایش</p>
      <div class="theme-modes" role="group" aria-label="حالت شب و روز">
        <button type="button" class="theme-mode-btn" data-mode="system" aria-pressed="false">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
          سیستم
        </button>
        <button type="button" class="theme-mode-btn" data-mode="light" aria-pressed="false">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          روز
        </button>
        <button type="button" class="theme-mode-btn" data-mode="dark" aria-pressed="false">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          شب
        </button>
      </div>
    </div>

    <div class="theme-panel__section">
      <p class="theme-panel__title">رنگ تم</p>
      <div class="theme-accents" role="group" aria-label="رنگ‌های تم">
        <button type="button" class="theme-accent-btn" data-accent="blue" title="آبی" aria-label="آبی" aria-pressed="false"></button>
        <button type="button" class="theme-accent-btn" data-accent="violet" title="بنفش" aria-label="بنفش" aria-pressed="false"></button>
        <button type="button" class="theme-accent-btn" data-accent="emerald" title="سبز" aria-label="سبز" aria-pressed="false"></button>
        <button type="button" class="theme-accent-btn" data-accent="amber" title="کهربایی" aria-label="کهربایی" aria-pressed="false"></button>
        <button type="button" class="theme-accent-btn" data-accent="rose" title="صورتی" aria-label="صورتی" aria-pressed="false"></button>
        <button type="button" class="theme-accent-btn" data-accent="cyan" title="فیروزه‌ای" aria-label="فیروزه‌ای" aria-pressed="false"></button>
      </div>
      <p class="theme-panel__hint">انتخاب شما در همین مرورگر ذخیره می‌شود.</p>
    </div>
  </div>
</div>
