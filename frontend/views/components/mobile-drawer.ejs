<div class="h-drawer" id="mobileDrawer" aria-hidden="true">
  <div class="h-drawer__backdrop" data-close-drawer></div>
  <aside class="h-drawer__panel" role="dialog" aria-label="منو">

    <div class="h-drawer__header">
      <%- include("./brand", { brandGradientId: "brandDrawer", brandSize: 30, brandShowText: true }) %>
      <button type="button" class="h-drawer__close" data-close-drawer aria-label="بستن">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Profile card (logged in) -->
    <div class="h-drawer__profile" id="drawerProfile" style="display:none;">
      <span class="h-drawer__avatar" id="drawerAvatar"></span>
      <div class="h-drawer__profile-info">
        <strong id="drawerName">کاربر</strong>
        <small id="drawerUsername">@—</small>
      </div>
    </div>

    <nav class="h-drawer__nav" id="drawerNav">

      <!-- Dashboard section — visible always when logged in -->
      <div class="h-drawer__section h-drawer__section--dashboard" id="drawerDashboardSection" style="display:none;">
        <%- include("./dashboard-nav-items", { variant: "drawer" }) %>
      </div>

      <!-- Site section -->
      <div class="h-drawer__section h-drawer__section--site" id="drawerSiteSection">
        <div class="h-drawer__section-label">سایت</div>

        <a href="/" class="h-drawer__link" data-nav="/" data-exact>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          خانه
        </a>
        <a href="/explore" class="h-drawer__link" data-nav="/explore">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          اکسپلور
        </a>
        <a href="/projects" class="h-drawer__link" data-nav="/projects">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
          </svg>
          پروژه‌ها
        </a>
        <a href="/users" class="h-drawer__link" data-nav="/users">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
          کاربران
        </a>
        <a href="/about" class="h-drawer__link" data-nav="/about">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
          درباره ما
        </a>
        <a href="/contact" class="h-drawer__link" data-nav="/contact">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
          تماس با ما
        </a>
      </div>
    </nav>

    <div class="h-drawer__footer">
      <div class="auth-guests" id="drawerGuests" style="visibility: hidden;">
        <a href="/auth/login" class="nav-btn nav-btn-outline">ورود</a>
        <a href="/auth/register" class="nav-btn nav-btn-primary">ثبت نام</a>
      </div>
      <button type="button" class="h-drawer__logout" id="drawerLogout" style="display:none;">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        خروج از حساب
      </button>
    </div>
  </aside>
</div>