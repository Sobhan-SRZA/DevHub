<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles/index.css">
  <link rel="stylesheet" href="/styles/dialog.css">
  <link rel="stylesheet" href="/styles/form-errors.css">
  <link rel="stylesheet" href="/styles/dashboard/dashboard.css">
  <link rel="stylesheet" href="/styles/dashboard/dashboard-nav.css">
  <link rel="stylesheet" href="/styles/dashboard/project-modal.css">
  <link rel="stylesheet" href="/styles/dashboard/tag-picker.css">
  <link rel="stylesheet" href="/styles/markdown-editor.css">
  <title>پروژه‌های من</title>
</head>

<body>
  <%- include("../components/header") %>
  <%- include("../components/dialogError") %>

  <div class="dash-layout">
    <%- include("../components/dashboard-nav") %>
    <%- include("../components/dash-breadcrumb", { pageTitle: "پروژه‌های من" }) %>

    <main class="dash-main">
      <!-- header / actions -->
      <div class="dash-head">
        <div>
          <h2 class="dash-title">پروژه‌های من</h2>
          <p class="dash-sub" id="projectsCount">—</p>
        </div>
        <button type="button" class="btn-primary" id="btnNewProject">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          پروژه جدید
        </button>
      </div>

      <!-- filters -->
      <div class="dash-filters">
        <div class="dash-search">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" id="filterSearch" placeholder="جستجو در پروژه‌ها...">
        </div>

        <select id="filterStatus" class="dash-select">
          <option value="">همه وضعیت‌ها</option>
          <option value="draft">پیش‌نویس</option>
          <option value="published">منتشر شده</option>
          <option value="archived">آرشیو</option>
        </select>

        <select id="filterSort" class="dash-select">
          <option value="recent">جدیدترین</option>
          <option value="rating">بیشترین امتیاز</option>
          <option value="downloads">بیشترین دانلود</option>
          <option value="stars">بیشترین ستاره</option>
        </select>
      </div>

      <!-- grid -->
      <div class="dash-grid" id="projectsGrid">
        <div class="dash-loading">در حال بارگذاری…</div>
      </div>

      <!-- pagination -->
      <div class="dash-pagination" id="pagination"></div>
    </main>
  </div>

  <!-- ============================= -->
  <!-- PROJECT MODAL (create / edit) -->
  <!-- ============================= -->
  <div class="modal-backdrop" id="projectModalBackdrop"></div>
  <div class="modal modal--lg" id="projectModal" role="dialog" aria-labelledby="projectModalTitle">
    <div class="modal__header">
      <div class="modal__header-info">
        <h3 class="modal__title" id="projectModalTitle">پروژه جدید</h3>
        <p class="modal__subtitle" id="projectModalSubtitle">اطلاعات پروژه را وارد کنید</p>
      </div>
      <button type="button" class="modal__close" id="projectModalClose" aria-label="بستن">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- step tabs -->
    <div class="modal__tabs" id="projectTabs">
      <button type="button" class="pm-tab active" data-tab="basic">
        <span class="pm-tab__num">1</span>
        <span>اطلاعات پایه</span>
      </button>
      <button type="button" class="pm-tab" data-tab="content">
        <span class="pm-tab__num">2</span>
        <span>محتوا</span>
      </button>
      <button type="button" class="pm-tab" data-tab="media">
        <span class="pm-tab__num">3</span>
        <span>رسانه</span>
      </button>
      <button type="button" class="pm-tab" data-tab="tags">
        <span class="pm-tab__num">4</span>
        <span>تگ‌ها</span>
      </button>
      <button type="button" class="pm-tab" data-tab="settings">
        <span class="pm-tab__num">5</span>
        <span>تنظیمات</span>
      </button>
    </div>

    <form class="modal__body" id="projectForm" novalidate>
      <input type="hidden" name="_id">

      <!-- ============================================== -->
      <!-- STEP 1 — BASIC                                 -->
      <!-- ============================================== -->
      <div class="pm-panel active" data-panel="basic">
        <div class="pm-section">
          <div class="pm-section__head">
            <h4 class="pm-section__title">اطلاعات اصلی</h4>
            <p class="pm-section__sub">عنوان و لینک گیت‌هاب پروژه</p>
          </div>

          <div class="field">
            <label for="p-title">عنوان پروژه <span class="req">*</span></label>
            <input id="p-title" type="text" name="title" required maxlength="120" placeholder="مثلاً: سیستم مدیریت وظایف">
          </div>

          <div class="field">
            <label for="p-slug">Slug <small>(اختیاری — خودکار ساخته می‌شود)</small></label>
            <input id="p-slug" type="text" name="slug" maxlength="80" placeholder="task-manager">
            <div class="field-hint">
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
              </svg>
              فقط حروف انگلیسی کوچک، عدد و خط تیره — در آدرس پروژه استفاده می‌شود
            </div>
          </div>

          <div class="field">
            <label for="p-githubUrl">
              لینک گیت‌هاب
              <small>(اختیاری — برای دریافت ستاره، فورک و...)</small>
            </label>
            <div class="pm-input-icon">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                <path d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.2 3.44 9.61 8.21 11.17.6.11.82-.26.82-.58v-2.02c-3.34.71-4.04-1.58-4.04-1.58-.55-1.36-1.34-1.72-1.34-1.72-1.09-.73.08-.71.08-.71 1.2.08 1.84 1.21 1.84 1.21 1.07 1.79 2.8 1.27 3.49.97.11-.76.42-1.27.76-1.56-2.67-.3-5.47-1.31-5.47-5.82 0-1.28.47-2.33 1.24-3.15-.13-.3-.54-1.51.12-3.14 0 0 1-.31 3.3 1.21a11.6 11.6 0 0 1 6 0c2.3-1.52 3.3-1.21 3.3-1.21.66 1.63.25 2.84.12 3.14.77.82 1.24 1.87 1.24 3.15 0 4.52-2.81 5.52-5.49 5.81.43.37.81 1.09.81 2.19v3.25c0 .32.22.7.83.58 4.77-1.56 8.2-5.97 8.2-11.17C24 5.78 18.63.5 12 .5z" />
              </svg>
              <input id="p-githubUrl" type="url" name="githubUrl" maxlength="300" placeholder="https://github.com/owner/repo">
            </div>
            <div class="field-hint" id="githubHint"></div>
          </div>

          <label class="checkbox checkbox--block">
            <input type="checkbox" name="autoSync" checked>
            <span>سینک خودکار با گیت‌هاب (ستاره، فورک، دانلود)</span>
          </label>
        </div>
      </div>

      <!-- ============================================== -->
      <!-- STEP 2 — CONTENT                              -->
      <!-- ============================================== -->
      <div class="pm-panel" data-panel="content">
        <div class="pm-section">
          <div class="pm-section__head">
            <h4 class="pm-section__title">توضیحات پروژه</h4>
            <p class="pm-section__sub">هرچه واضح‌تر، بهتر</p>
          </div>

          <div class="field">
            <label for="p-shortDescription">توضیحات مختصر <span class="req">*</span></label>
            <textarea id="p-shortDescription" name="shortDescription" rows="2" required maxlength="300" placeholder="یک توضیح کوتاه در چند کلمه..."></textarea>
            <div class="field-hint field-hint--counter">
              <span id="shortCount">0</span> / 300
            </div>
          </div>

          <div class="field">
            <label for="p-fullDescription">شرح کامل <span class="req">*</span></label>
            <div id="fullDescriptionEditor"></div>
            <input type="hidden" name="fullDescription">
          </div>
        </div>
      </div>

      <!-- ============================================== -->
      <!-- STEP 3 — MEDIA                                -->
      <!-- ============================================== -->
      <div class="pm-panel" data-panel="media">
        <!-- Images -->
        <div class="pm-section">
          <div class="pm-section__head">
            <h4 class="pm-section__title">
              تصاویر پروژه
              <span class="pm-badge" id="imagesCount">0/10</span>
            </h4>
            <p class="pm-section__sub">حداکثر ۱۰ تصویر — اولین تصویر به‌عنوان کاور استفاده می‌شود</p>
          </div>

          <div class="pm-dropzone" id="imagesDropzone">
            <input type="file" id="imagesInput" accept="image/jpeg,image/png,image/webp,image/gif" multiple hidden>
            <div class="pm-dropzone__inner">
              <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="17 8 12 3 7 8"></polyline>
                <line x1="12" y1="3" x2="12" y2="15"></line>
              </svg>
              <p class="pm-dropzone__title">تصاویر را اینجا رها کنید یا کلیک کنید</p>
              <p class="pm-dropzone__sub">JPG, PNG, WebP, GIF — حداکثر 5MB هر تصویر</p>
            </div>
          </div>

          <div class="pm-images-grid" id="imagesGrid"></div>
        </div>

        <!-- Video -->
        <div class="pm-section">
          <div class="pm-section__head">
            <h4 class="pm-section__title">ویدیو دمو</h4>
            <p class="pm-section__sub">یک ویدیو برای نمایش عملکرد پروژه — حداکثر 200MB</p>
          </div>

          <div id="videoContainer">
            <div class="pm-dropzone pm-dropzone--video" id="videoDropzone">
              <input type="file" id="videoInput" accept="video/mp4,video/webm,video/quicktime" hidden>
              <div class="pm-dropzone__inner">
                <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="23 7 16 12 23 17 23 7"></polygon>
                  <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                </svg>
                <p class="pm-dropzone__title">ویدیو را اینجا رها کنید یا کلیک کنید</p>
                <p class="pm-dropzone__sub">MP4, WebM, MOV</p>
              </div>
            </div>
          </div>
        </div>

        <!-- ZIP -->
        <div class="pm-section">
          <div class="pm-section__head">
            <h4 class="pm-section__title">فایل پروژه (ZIP)</h4>
            <p class="pm-section__sub">فایل دانلودی پروژه — حداکثر 500MB</p>
          </div>

          <div id="fileContainer">
            <div class="pm-dropzone pm-dropzone--file" id="fileDropzone">
              <input type="file" id="fileInput" accept=".zip,.rar,.7z,.tar,.gz" hidden>
              <div class="pm-dropzone__inner">
                <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <p class="pm-dropzone__title">فایل ZIP را اینجا رها کنید یا کلیک کنید</p>
                <p class="pm-dropzone__sub">ZIP, RAR, 7Z, TAR, GZ</p>
              </div>
            </div>
          </div>

          <div class="field" id="fileVersionField" style="display:none; margin-top:12px;">
            <label for="p-fileVersion">نسخه فایل <small>(اختیاری)</small></label>
            <input id="p-fileVersion" type="text" maxlength="20" placeholder="1.0.0">
          </div>
        </div>
      </div>

      <!-- ============================================== -->
      <!-- STEP 4 — TAGS                                 -->
      <!-- ============================================== -->
      <div class="pm-panel" data-panel="tags">
        <div class="pm-section">
          <div class="pm-section__head">
            <h4 class="pm-section__title">
              تگ‌ها
              <span class="pm-badge" id="tagsCountBadge">0/20</span>
            </h4>
            <p class="pm-section__sub">
              تگ‌ها را از کتگوری‌های مختلف انتخاب یا بسازید
            </p>
          </div>

          <div id="tagPickerRoot"></div>
        </div>
      </div>

      <!-- ============================================== -->
      <!-- STEP 5 — SETTINGS                             -->
      <!-- ============================================== -->
      <div class="pm-panel" data-panel="settings">
        <div class="pm-section">
          <div class="pm-section__head">
            <h4 class="pm-section__title">تنظیمات انتشار</h4>
            <p class="pm-section__sub">کنترل کنید چه کسی پروژه را ببیند</p>
          </div>

          <div class="field">
            <label>وضعیت پروژه</label>
            <div class="pm-radio-group">
              <label class="pm-radio">
                <input type="radio" name="status" value="draft">
                <div class="pm-radio__card">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                  </svg>
                  <div>
                    <strong>پیش‌نویس</strong>
                    <small>فقط خودت می‌بینی</small>
                  </div>
                </div>
              </label>

              <label class="pm-radio">
                <input type="radio" name="status" value="published" checked>
                <div class="pm-radio__card">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="2" y1="12" x2="22" y2="12"></line>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                  </svg>
                  <div>
                    <strong>منتشر شده</strong>
                    <small>برای همه قابل مشاهده</small>
                  </div>
                </div>
              </label>

              <label class="pm-radio">
                <input type="radio" name="status" value="archived">
                <div class="pm-radio__card">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="21 8 21 21 3 21 3 8"></polyline>
                    <rect x="1" y="3" width="22" height="5"></rect>
                    <line x1="10" y1="12" x2="14" y2="12"></line>
                  </svg>
                  <div>
                    <strong>آرشیو</strong>
                    <small>مخفی از لیست اصلی</small>
                  </div>
                </div>
              </label>
            </div>
          </div>

          <label class="checkbox checkbox--block">
            <input type="checkbox" name="isPublic" checked>
            <div>
              <strong>نمایش عمومی</strong>
              <small>پروژه در لیست عمومی نمایش داده شود</small>
            </div>
          </label>
        </div>
      </div>
    </form>

    <div class="modal__footer">
      <div class="modal__footer-left">
        <button type="button" class="btn-ghost" id="projectModalPrev" style="display:none;">
          ← قبلی
        </button>
      </div>

      <div class="modal__footer-right">
        <button type="button" class="btn-ghost" id="projectModalCancel">انصراف</button>
        <button type="button" class="btn-secondary" id="projectModalNext">
          بعدی →
        </button>
        <button type="submit" form="projectForm" class="btn-primary" id="projectModalSubmit" style="display:none;">
          ذخیره پروژه
        </button>
      </div>
    </div>
  </div>

  <script src="/js/form-errors.js"></script>
  <script src="/js/dashboard-nav.js"></script>
  <script src="/js/components/tag-picker.js"></script>
  <script src="/js/components/markdown-editor.js"></script>
  <script src="/js/dashboard/projects.js"></script>
</body>

</html>