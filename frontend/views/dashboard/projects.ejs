<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
  <!-- Apply persisted theme and accent preferences before first paint to prevent flashing. -->
  <meta charset="UTF-8">
  <script>
    (function() {
      try {
        var mode = localStorage.getItem('dh-mode') || 'system';
        var accent = localStorage.getItem('dh-accent') || 'blue';
        var resolvedMode = mode === 'system' ?
          (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark') :
          mode;

        document.documentElement.setAttribute('data-mode', resolvedMode);
        document.documentElement.setAttribute('data-accent', accent);
        document.documentElement.style.colorScheme = resolvedMode;
      } catch (e) {}
    })();
  </script>

  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">

  <!-- Fonts and global styles -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="/styles/index.css">
  <link rel="stylesheet" href="/styles/themes.css">

  <!-- Favicon -->
  <link rel="icon" href="/assets/logo.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/assets/logo.svg">

  <!-- Page-specific styles -->
  <link rel="stylesheet" href="/styles/dialog.css">
  <link rel="stylesheet" href="/styles/form-errors.css">
  <link rel="stylesheet" href="/styles/dashboard/dashboard.css">
  <link rel="stylesheet" href="/styles/dashboard/dashboard-nav.css">
  <link rel="stylesheet" href="/styles/tailwind.css">
  <link rel="stylesheet" href="/styles/dashboard/project-modal.css">
  <link rel="stylesheet" href="/styles/dashboard/tag-picker.css">
  <link rel="stylesheet" href="/styles/markdown-editor.css">

  <title>My Projects</title>
</head>

<body>
  <%- include("../components/dialogError") %>

  <div class="dash-layout">
    <%- include("../components/dashboard-nav") %>
    <%- include("../components/dash-breadcrumb", { pageTitle: "My Projects" }) %>

    <main class="dash-main">
      <!-- ============ PAGE HEADER ============ -->
      <div class="dash-head">
        <div>
          <h2 class="dash-title">My Projects</h2>
          <p class="dash-sub" id="projectsCount">—</p>
        </div>

        <button type="button" class="btn-primary" id="btnNewProject">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          New Project
        </button>
      </div>

      <!-- ============ FILTERS ============ -->
      <div class="dash-filters">
        <div class="dash-search">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" id="filterSearch" placeholder="Search projects...">
        </div>

        <select id="filterStatus" class="dash-select">
          <option value="">All statuses</option>
          <option value="draft">Draft</option>
          <option value="published">Published</option>
          <option value="archived">Archived</option>
        </select>

        <select id="filterSort" class="dash-select">
          <option value="recent">Newest</option>
          <option value="rating">Highest rated</option>
          <option value="downloads">Most downloaded</option>
          <option value="stars">Most starred</option>
        </select>
      </div>

      <!-- ============ PROJECT GRID ============ -->
      <div class="dash-grid" id="projectsGrid">
        <div class="dash-loading">Loading…</div>
      </div>

      <!-- ============ PAGINATION ============ -->
      <div class="dash-pagination" id="pagination"></div>
    </main>
  </div>

  <!-- ================================================================
       PROJECT MODAL (CREATE / EDIT)
       A multi-step wizard used for creating and editing projects. Each
       step is a tab; navigation between steps is handled client-side.
       ================================================================ -->
  <div class="modal-backdrop" id="projectModalBackdrop"></div>
  <div class="modal modal--lg" id="projectModal" role="dialog" aria-labelledby="projectModalTitle">
    <div class="modal__header">
      <div class="modal__header-info">
        <h3 class="modal__title" id="projectModalTitle">New Project</h3>
        <p class="modal__subtitle" id="projectModalSubtitle">Enter the project details</p>
      </div>

      <button type="button" class="modal__close" id="projectModalClose" aria-label="Close">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Step tabs -->
    <div class="modal__tabs" id="projectTabs">
      <button type="button" class="pm-tab active" data-tab="basic">
        <span class="pm-tab__num">1</span>
        <span>Basic Information</span>
      </button>
      <button type="button" class="pm-tab" data-tab="content">
        <span class="pm-tab__num">2</span>
        <span>Content</span>
      </button>
      <button type="button" class="pm-tab" data-tab="media">
        <span class="pm-tab__num">3</span>
        <span>Media</span>
      </button>
      <button type="button" class="pm-tab" data-tab="tags">
        <span class="pm-tab__num">4</span>
        <span>Tags</span>
      </button>
      <button type="button" class="pm-tab" data-tab="settings">
        <span class="pm-tab__num">5</span>
        <span>Settings</span>
      </button>
    </div>

    <form class="modal__body" id="projectForm" novalidate>
      <input type="hidden" name="_id">

      <!-- ==============================================
           STEP 1 — BASIC INFORMATION
           ============================================== -->
      <div class="pm-panel active" data-panel="basic">
        <div class="pm-section">
          <div class="pm-section__head">
            <h4 class="pm-section__title">Main information</h4>
            <p class="pm-section__sub">Project title and GitHub link</p>
          </div>

          <div class="field">
            <label for="p-title">Project title <span class="req">*</span></label>
            <input id="p-title" type="text" name="title" required maxlength="120" placeholder="e.g., Task management system">
          </div>

          <div class="field">
            <label for="p-slug">Slug <small>(optional — generated automatically)</small></label>
            <input id="p-slug" type="text" name="slug" maxlength="80" placeholder="task-manager">
            <div class="field-hint">
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
              </svg>
              Lowercase English letters, numbers, and hyphens only — used in the project URL
            </div>
          </div>

          <div class="field">
            <label for="p-githubUrl">
              GitHub URL
              <small>(optional — for fetching stars, forks, etc.)</small>
            </label>
            <div class="pm-input-icon">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                <path d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.2 3.44 9.61 8.21 11.17.6.11.82-.26.82-.58v-2.02c-3.34.71-4.04-1.58-4.04-1.58-.55-1.36-1.34-1.72-1.34-1.72-1.09-.73.08-.71.08-.71 1.2.08 1.84 1.21 1.84 1.21 1.07 1.79 2.8 1.27 3.49.97.11-.76.42-1.27.76-1.56-2.67-.3-5.47-1.31-5.47-5.82 0-1.28.47-2.33 1.24-3.15-.13-.3-.54-1.51.12-3.14 0 0 1-.31 3.3 1.21a11.6 11.6 0 0 1 6 0c2.3-1.52 3.3-1.21 3.3-1.21.66 1.63.25 2.84.12 3.14.77.82 1.24 1.87 1.24 3.15 0 4.52-2.81 5.52-5.49 5.81.43.37.81 1.09.81 2.19v3.25c0 .32.22.7.83.58 4.77-1.56 8.2-5.97 8.2-11.17C24 5.78 18.63.5 12 .5z" />
              </svg>
              <input id="p-githubUrl" type="url" name="githubUrl" maxlength="300" placeholder="https://github.com/owner/repo">
            </div>
            <div class="field-hint" id="githubHint"></div>
          </div>

          <label class="checkbox checkbox--block">
            <input type="checkbox" name="autoSync" checked>
            <span>Automatically sync with GitHub (stars, forks, downloads)</span>
          </label>
        </div>
      </div>

      <!-- ==============================================
           STEP 2 — CONTENT
           ============================================== -->
      <div class="pm-panel" data-panel="content">
        <div class="pm-section">
          <div class="pm-section__head">
            <h4 class="pm-section__title">Project description</h4>
            <p class="pm-section__sub">The clearer, the better</p>
          </div>

          <div class="field">
            <label for="p-shortDescription">Short description <span class="req">*</span></label>
            <textarea id="p-shortDescription" name="shortDescription" rows="2" required maxlength="500" placeholder="A brief description in a few words..."></textarea>
            <div class="field-hint field-hint--counter">
              <span id="shortCount">0</span> / 500
            </div>
          </div>

          <div class="field">
            <label for="p-fullDescription">Full description <span class="req">*</span></label>
            <div id="fullDescriptionEditor"></div>
            <input type="hidden" name="fullDescription">
          </div>
        </div>
      </div>

      <!-- ==============================================
           STEP 3 — MEDIA
           ============================================== -->
      <div class="pm-panel" data-panel="media">
        <!-- Images -->
        <div class="pm-section">
          <div class="pm-section__head">
            <h4 class="pm-section__title">
              Project images
              <span class="pm-badge" id="imagesCount">0/10</span>
            </h4>
            <p class="pm-section__sub">Up to 10 images — the first image is used as the cover</p>
          </div>

          <div class="pm-dropzone" id="imagesDropzone">
            <input type="file" id="imagesInput" accept="image/jpeg,image/png,image/webp,image/gif" multiple hidden>
            <div class="pm-dropzone__inner">
              <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="17 8 12 3 7 8"></polyline>
                <line x1="12" y1="3" x2="12" y2="15"></line>
              </svg>
              <p class="pm-dropzone__title">Drop images here or click to browse</p>
              <p class="pm-dropzone__sub">JPG, PNG, WebP, GIF — max 5 MB per image</p>
            </div>
          </div>

          <div class="pm-images-grid" id="imagesGrid"></div>
        </div>

        <!-- Video -->
        <div class="pm-section">
          <div class="pm-section__head">
            <h4 class="pm-section__title">Demo video</h4>
            <p class="pm-section__sub">One video demonstrating project functionality — max 200 MB</p>
          </div>

          <div id="videoContainer">
            <div class="pm-dropzone pm-dropzone--video" id="videoDropzone">
              <input type="file" id="videoInput" accept="video/mp4,video/webm,video/quicktime" hidden>
              <div class="pm-dropzone__inner">
                <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="23 7 16 12 23 17 23 7"></polygon>
                  <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                </svg>
                <p class="pm-dropzone__title">Drop the video here or click to browse</p>
                <p class="pm-dropzone__sub">MP4, WebM, MOV</p>
              </div>
            </div>
          </div>
        </div>

        <!-- ZIP archive -->
        <div class="pm-section">
          <div class="pm-section__head">
            <h4 class="pm-section__title">Project file (ZIP)</h4>
            <p class="pm-section__sub">The downloadable project file — max 500 MB</p>
          </div>

          <div id="fileContainer">
            <div class="pm-dropzone pm-dropzone--file" id="fileDropzone">
              <input type="file" id="fileInput" accept=".zip,.rar,.7z,.tar,.gz" hidden>
              <div class="pm-dropzone__inner">
                <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <p class="pm-dropzone__title">Drop the ZIP file here or click to browse</p>
                <p class="pm-dropzone__sub">ZIP, RAR, 7Z, TAR, GZ</p>
              </div>
            </div>
          </div>

          <div class="field" id="fileVersionField" style="display:none; margin-top:12px;">
            <label for="p-fileVersion">File version <small>(optional)</small></label>
            <input id="p-fileVersion" type="text" maxlength="20" placeholder="1.0.0">
          </div>
        </div>
      </div>

      <!-- ==============================================
           STEP 4 — TAGS
           ============================================== -->
      <div class="pm-panel" data-panel="tags">
        <div class="pm-section">
          <div class="pm-section__head">
            <h4 class="pm-section__title">
              Tags
              <span class="pm-badge" id="tagsCountBadge">0/20</span>
            </h4>
            <p class="pm-section__sub">
              Select tags from different categories or create new ones
            </p>
          </div>

          <div id="tagPickerRoot"></div>
        </div>
      </div>

      <!-- ==============================================
           STEP 5 — SETTINGS
           ============================================== -->
      <div class="pm-panel" data-panel="settings">
        <div class="pm-section">
          <div class="pm-section__head">
            <h4 class="pm-section__title">Publishing settings</h4>
            <p class="pm-section__sub">Control who can see the project</p>
          </div>

          <div class="field">
            <label>Project status</label>
            <div class="pm-radio-group">
              <label class="pm-radio">
                <input type="radio" name="status" value="draft">
                <div class="pm-radio__card">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                  </svg>
                  <div>
                    <strong>Draft</strong>
                    <small>Only you can see it</small>
                  </div>
                </div>
              </label>

              <label class="pm-radio">
                <input type="radio" name="status" value="published" checked>
                <div class="pm-radio__card">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="2" y1="12" x2="22" y2="12"></line>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                  </svg>
                  <div>
                    <strong>Published</strong>
                    <small>Visible to everyone</small>
                  </div>
                </div>
              </label>

              <label class="pm-radio">
                <input type="radio" name="status" value="archived">
                <div class="pm-radio__card">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="21 8 21 21 3 21 3 8"></polyline>
                    <rect x="1" y="3" width="22" height="5"></rect>
                    <line x1="10" y1="12" x2="14" y2="12"></line>
                  </svg>
                  <div>
                    <strong>Archived</strong>
                    <small>Hidden from the main list</small>
                  </div>
                </div>
              </label>
            </div>
          </div>

          <label class="checkbox checkbox--block">
            <input type="checkbox" name="isPublic" checked>
            <div>
              <strong>Public visibility</strong>
              <small>Show the project in the public list</small>
            </div>
          </label>
        </div>
      </div>
    </form>

    <!-- Modal footer navigation -->
    <div class="modal__footer">
      <div class="modal__footer-left">
        <button type="button" class="btn-ghost" id="projectModalPrev" style="display:none;">
          ← Previous
        </button>
      </div>

      <div class="modal__footer-right">
        <button type="button" class="btn-ghost" id="projectModalCancel">Cancel</button>
        <button type="button" class="btn-secondary" id="projectModalNext">
          Next →
        </button>
        <button type="submit" form="projectForm" class="btn-primary" id="projectModalSubmit" style="display:none;">
          Save Project
        </button>
      </div>
    </div>
  </div>

  <script src="/js/form-errors.js"></script>
  <script src="/js/dashboard-nav.js"></script>
  <script src="/js/components/tag-picker.js"></script>
  <script src="/js/components/markdown-editor.js"></script>
  <script src="/js/dashboard/projects.js"></script>
</body>

</html>