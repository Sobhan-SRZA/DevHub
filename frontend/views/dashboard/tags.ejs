<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
  <meta charset="UTF-8">
  <script>(function(){try{var m=localStorage.getItem('dh-mode')||'system';var a=localStorage.getItem('dh-accent')||'blue';var r=m==='system'?(window.matchMedia('(prefers-color-scheme: light)').matches?'light':'dark'):m;document.documentElement.setAttribute('data-mode',r);document.documentElement.setAttribute('data-accent',a);document.documentElement.style.colorScheme=r;}catch(e){}})();</script>

  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
    <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="/styles/index.css">
  <link rel="stylesheet" href="/styles/themes.css">

  <link rel="stylesheet" href="/styles/dialog.css">
  <link rel="stylesheet" href="/styles/form-errors.css">
  <link rel="stylesheet" href="/styles/dashboard/dashboard.css">
  <link rel="stylesheet" href="/styles/dashboard/dashboard-nav.css">
  <link rel="stylesheet" href="/styles/tailwind.css">
  <title>تگ‌ها</title>
</head>

<body>
  <%- include("../components/dialogError") %>

  <div class="dash-layout">
    <%- include("../components/dashboard-nav") %>
    <%- include("../components/dash-breadcrumb", { pageTitle: "تگ‌ها" }) %>

    <main class="dash-main">
      <div class="dash-head">
        <div>
          <h2 class="dash-title">مدیریت تگ‌ها</h2>
          <p class="dash-sub" id="tagsCount">—</p>
        </div>
        <button type="button" class="btn-primary" id="btnNewTag">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          تگ جدید
        </button>
      </div>

      <div class="dash-filters">
        <div class="dash-search">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" id="tagSearch" placeholder="جستجوی تگ...">
        </div>
        <select id="tagFilterType" class="dash-select">
          <option value="">همه نوع‌ها</option>
        </select>
        <select id="tagSort" class="dash-select">
          <option value="usage">پرکاربردترین</option>
          <option value="name">بر اساس نام</option>
          <option value="recent">جدیدترین</option>
        </select>
      </div>

      <div class="tag-list" id="tagsList">
        <div class="dash-loading">در حال بارگذاری…</div>
      </div>

      <div class="dash-pagination" id="tagsPagination"></div>
    </main>
  </div>

  <!-- TAG MODAL -->
  <div class="modal-backdrop" id="tagModalBackdrop"></div>
  <div class="modal modal--sm" id="tagModal" role="dialog">
    <div class="modal__header">
      <h3 class="modal__title" id="tagModalTitle">تگ جدید</h3>
      <button type="button" class="modal__close" id="tagModalClose">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <form class="modal__body" id="tagForm" novalidate>
      <input type="hidden" name="_id">

      <div class="field">
        <label for="t-name">نام تگ <span class="req">*</span></label>
        <input id="t-name" type="text" name="name" required maxlength="40" placeholder="React">
      </div>

      <div class="field">
        <label for="t-type">نوع تگ <span class="req">*</span></label>
        <select id="t-type" name="type" required></select>
      </div>

      <div class="field">
        <label for="t-color">رنگ</label>
        <input id="t-color" type="color" name="color" value="#6ebbff">
      </div>

      <div class="field">
        <label for="t-description">توضیح <small>(اختیاری)</small></label>
        <textarea id="t-description" name="description" rows="2" maxlength="200"></textarea>
      </div>
    </form>

    <div class="modal__footer">
      <button type="button" class="btn-ghost" id="tagModalCancel">انصراف</button>
      <button type="submit" form="tagForm" class="btn-primary" id="tagModalSubmit">ذخیره</button>
    </div>
  </div>

  <script src="/js/form-errors.js"></script>
  <script src="/js/dashboard-nav.js"></script>
  <script src="/js/dashboard/tags.js"></script>
</body>

</html>