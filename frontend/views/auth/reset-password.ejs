<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
  <!-- SEO metadata for the reset-password page -->
  <%- include("../components/seo-head", {
    title: "Reset Password",
    description: "Set a new password for your DevHub account.",
    noindex: true,
    canonicalPath: "/auth/reset-password",
    extraStyles: ["/styles/dialog.css", "/styles/form-errors.css", "/styles/auth.css", "/styles/auth/password-reset.css"]
  }) %>
</head>

<body>
  <!-- Site header and global error dialog -->
  <%- include("../components/header") %>
  <%- include("../components/dialogError") %>

  <section class="container auth">
    <div class="auth-card pr-card">
      <!-- Page icon -->
      <div class="pr-icon pr-icon--reset">
        <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path>
        </svg>
      </div>

      <h2 class="pr-title">New Password</h2>
      <p class="pr-sub">
        Enter the 6-digit code sent to the email below and choose your new password.
      </p>

      <!-- Displays the email address the reset code was sent to -->
      <div class="pr-email-display" id="emailDisplay">—</div>

      <!-- Password reset form -->
      <form class="pr-form" id="resetForm" novalidate>
        <!-- One-time verification code -->
        <div class="field">
          <label for="code">Verification Code <span class="req">*</span></label>
          <input id="code" type="text" name="code" maxlength="6" inputmode="numeric" pattern="\d{6}" placeholder="------" autocomplete="one-time-code" class="otp-input" dir="ltr" required>
        </div>

        <!-- New password with visibility toggle and strength feedback -->
        <div class="field">
          <label for="newPassword">New Password <span class="req">*</span></label>
          <div class="password-wrap">
            <input id="newPassword" type="password" name="newPassword" placeholder="••••••••" autocomplete="new-password" dir="ltr" required>
            <button type="button" class="toggle-pass" data-target="newPassword" aria-label="Show password">
              <svg class="icon icon-eye" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              <svg class="icon icon-eye-off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                <line x1="1" y1="1" x2="23" y2="23"></line>
              </svg>
            </button>
          </div>

          <!-- Password strength indicator -->
          <div class="pw-strength">
            <div class="pw-strength__bars">
              <span></span><span></span><span></span><span></span>
            </div>
            <span class="pw-strength__label" id="pwStrengthLabel"></span>
          </div>

          <!-- Password requirement checklist -->
          <ul class="pw-rules" id="pwRules">
            <li data-rule="length">At least 8 characters</li>
            <li data-rule="lower">Lowercase letter (a-z)</li>
            <li data-rule="upper">Uppercase letter (A-Z)</li>
            <li data-rule="digit">Digit (0-9)</li>
          </ul>
        </div>

        <!-- Password confirmation -->
        <div class="field">
          <label for="confirmPassword">Confirm New Password <span class="req">*</span></label>
          <div class="password-wrap">
            <input id="confirmPassword" type="password" name="confirmPassword" placeholder="••••••••" autocomplete="new-password" dir="ltr" required>
            <button type="button" class="toggle-pass" data-target="confirmPassword" aria-label="Show password">
              <svg class="icon icon-eye" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              <svg class="icon icon-eye-off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                <line x1="1" y1="1" x2="23" y2="23"></line>
              </svg>
            </button>
          </div>
          <small class="field-error" id="matchError"></small>
        </div>

        <button type="submit" class="auth-btn" id="submitBtn">
          Change Password
        </button>
      </form>

      <!-- Resend code control with cooldown timer -->
      <div class="pr-resend">
        <span>Didn't receive the code?</span>
        <button type="button" class="auth-link pr-resend-btn" id="resendBtn">
          Resend
        </button>
        <span class="pr-resend-timer" id="resendTimer" style="display:none;">
          (<span id="resendCountdown">60</span>s)
        </span>
      </div>

      <!-- Delivery and expiry hints -->
      <p class="pr-hint">
        Also check your <strong>Spam</strong> folder.
        The code is valid for <strong>15 minutes</strong>.
      </p>

      <p class="pr-foot">
        <a href="/forgot-password" class="auth-link">Wrong email? Start over</a>
      </p>
    </div>
  </section>

  <script src="/js/form-errors.js"></script>
  <script src="/js/auth/reset-password.js"></script>
</body>

</html>