<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles/index.css">
  <link rel="stylesheet" href="/styles/dialog.css">
  <link rel="stylesheet" href="/styles/form-errors.css">
  <link rel="stylesheet" href="/styles/auth.css">
  <link rel="stylesheet" href="/styles/auth/password-reset.css">
  <title>فراموشی رمز عبور</title>
</head>

<body>
  <%- include("../components/header") %>
  <%- include("../components/dialogError") %>

  <section class="container auth">
    <div class="auth-card pr-card">

      <!-- icon -->
      <div class="pr-icon pr-icon--forgot">
        <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>

      <h2 class="pr-title">فراموشی رمز عبور</h2>
      <p class="pr-sub">
        ایمیل حساب خود را وارد کنید تا کد بازیابی برایتان ارسال شود
      </p>

      <!-- form -->
      <form class="pr-form" id="forgotForm" novalidate>
        <div class="field">
          <label for="email">ایمیل <span class="req">*</span></label>
          <div class="pr-input-icon">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <input id="email" type="email" name="email" placeholder="you@example.com" autocomplete="email" dir="ltr" required>
          </div>
        </div>

        <button type="submit" class="auth-btn" id="submitBtn">
          ارسال کد بازیابی
        </button>
      </form>

      <!-- info -->
      <div class="pr-info">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        <span>اگر ایمیل در سیستم موجود باشد، کد برایتان ارسال می‌شود</span>
      </div>

      <!-- footer -->
      <p class="pr-foot">
        رمزت را به یاد آوردی؟
        <a href="/login" class="auth-link">بازگشت به ورود</a>
      </p>
    </div>
  </section>

  <script src="/js/form-errors.js"></script>
  <script src="/js/auth/forgot-password.js"></script>
</body>

</html>