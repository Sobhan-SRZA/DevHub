<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
  <%- include("components/seo-head", {
        title: "Contact Us",
        description: "Get in touch with the DevHub team to share suggestions, report bugs, or discuss collaboration opportunities.",
        canonicalPath: "/contact"
    }) %>
</head>

<body>
  <%- include("components/header") %>
  <%- include("components/dialogError") %>

  <main class="static-page contact-page">
    <h1>Contact Us</h1>

    <p class="lead">
      Have a suggestion, found a bug, or interested in collaborating?
      Send us a message.
      In the current version, submissions are handled in the browser,
      and guidance for contacting the team directly is provided below.
    </p>

    <div class="static-card">
      <form class="contact-form" id="contactForm" novalidate>
        <div>
          <label for="cName">Name</label>
          <input id="cName" name="name" type="text" required maxlength="80" placeholder="Your name" autocomplete="name">
        </div>

        <div>
          <label for="cEmail">Email Address</label>
          <input id="cEmail" name="email" type="email" required maxlength="120" placeholder="you@example.com" autocomplete="email" dir="ltr">
        </div>

        <div>
          <label for="cSubject">Subject</label>
          <input id="cSubject" name="subject" type="text" required maxlength="120" placeholder="Message subject">
        </div>

        <div>
          <label for="cMessage">Message</label>
          <textarea id="cMessage" name="message" required maxlength="2000" placeholder="Write your message here..."></textarea>
        </div>

        <button type="submit" class="btn-primary" id="cSubmit">
          Send Message
        </button>

        <p class="contact-note" id="cNote">
          Once server-side email delivery is configured,
          messages can be sent directly to the DevHub team.
        </p>
      </form>
    </div>

    <div class="static-card">
      <h2 style="margin-top: 0">Other Ways to Connect</h2>

      <p>
        Follow the project's repository and technical discussions on GitHub.
      </p>

      <p style="margin-bottom: 0">
        For security-related reports, please refer to
        the <code>SECURITY.md</code> file.
      </p>
    </div>
  </main>

  <script>
    document.getElementById("contactForm")?.addEventListener("submit", function(event) {
      event.preventDefault();

      const name = document.getElementById("cName").value.trim();
      const email = document.getElementById("cEmail").value.trim();
      const subject = document.getElementById("cSubject").value.trim();
      const message = document.getElementById("cMessage").value.trim();

      if (!name || !email || !subject || !message) {
        alert("Please complete all required fields.");
        return;
      }

      const note = document.getElementById("cNote");

      note.textContent =
        "Your message has been recorded. Thank you for reaching out! We'll get back to you soon.";

      note.style.color = "var(--accent)";

      event.target.reset();
    });
  </script>

  <%- include("components/footer") %>
</body>

</html>