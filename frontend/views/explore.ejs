<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <%- include("components/seo-head", {
      title: "کاوش پروژه‌ها",
      description: "جستجو، فیلتر و کشف پروژه‌های متن‌باز در DevHub. مرتب‌سازی بر اساس داغ، برتر، جدید و پربازدید.",
      keywords: "کاوش پروژه, جستجوی پروژه متن‌باز, فیلتر پروژه, DevHub, trending, hot",
      canonicalPath: "/explore",
      extraStyles: ["/styles/dialog.css", "/styles/form-errors.css", "/styles/explore.css"]
    }) %>
</head>

<body>
    <%- include("components/header") %>
    <%- include("components/dialogError") %>

    <main class="explore-page">

        <!-- ============ HERO SMALL ============ -->
        <section class="explore-hero">
            <h1 class="explore-hero__title">کاوش پروژه‌ها</h1>
            <p class="explore-hero__sub">پروژه‌های متن‌باز را جستجو، فیلتر و کشف کنید</p>
        </section>

        <!-- ============ FILTERS ============ -->
        <section class="explore-filters">

            <!-- Search -->
            <div class="explore-search">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" id="exploreSearch" placeholder="جستجوی پروژه، تکنولوژی، …">
            </div>

            <!-- Sort tabs -->
            <div class="explore-sort" id="exploreSort">
                <button type="button" class="ex-sort active" data-sort="trending" data-window="7d">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                        <polyline points="17 6 23 6 23 12"></polyline>
                    </svg>
                    داغ
                </button>
                <button type="button" class="ex-sort" data-sort="hot" data-window="24h">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
                    </svg>
                    پرطرفدار امروز
                </button>
                <button type="button" class="ex-sort" data-sort="top-rated">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                    برترین
                </button>
                <button type="button" class="ex-sort" data-sort="top-downloaded">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    پرطرفدار دانلود
                </button>
                <button type="button" class="ex-sort" data-sort="new">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    جدید
                </button>
            </div>

            <!-- Category filter -->
            <div class="explore-types" id="exploreTypes">
                <button type="button" class="ex-chip active" data-type="">همه</button>
                <!-- پر می‌شه با JS -->
            </div>
        </section>

        <!-- ============ CONTENT ============ -->
        <section class="explore-content">
            <div class="explore-meta" id="exploreMeta"></div>

            <div class="explore-grid" id="exploreGrid">
                <div class="home-loading">
                    <div class="home-loading__spinner"></div>
                </div>
            </div>

            <div class="explore-pagination" id="explorePagination"></div>
        </section>

    </main>

    <script defer src="/js/form-errors.js"></script>
    <script defer src="/js/pages/explore.js"></script>
  <%- include("components/footer") %>
</body>

</html>