<link rel="stylesheet" href="/styles/dialog.css">

<!-- backdrop -->
<div class="dialog-backdrop" id="dialogBackdrop" aria-hidden="true"></div>

<!-- error / info dialog -->
<dialog class="app-dialog" id="appDialog" aria-labelledby="appDialogTitle">
  <div class="app-dialog__icon" id="appDialogIcon">!</div>
  <h2 class="app-dialog__title" id="appDialogTitle">—</h2>
  <p class="app-dialog__message" id="appDialogMessage">—</p>
  <div class="app-dialog__actions">
    <button type="button" class="app-dialog__btn app-dialog__btn--primary" id="appDialogOk">باشه</button>
  </div>
</dialog>

<!-- confirm dialog -->
<dialog class="app-dialog app-dialog--confirm" id="confirmDialog" aria-labelledby="confirmDialogTitle">
  <div class="app-dialog__icon app-dialog__icon--warn" id="confirmDialogIcon">؟</div>
  <h2 class="app-dialog__title" id="confirmDialogTitle">تایید</h2>
  <p class="app-dialog__message" id="confirmDialogMessage">—</p>
  <div class="app-dialog__actions">
    <button type="button" class="app-dialog__btn app-dialog__btn--ghost" id="confirmDialogCancel">انصراف</button>
    <button type="button" class="app-dialog__btn app-dialog__btn--danger" id="confirmDialogOk">تایید</button>
  </div>
</dialog>

<!-- toast container -->
<div class="toast-container" id="toastContainer" aria-live="polite" aria-atomic="true"></div>

<script src="/js/dialog-error.js"></script>