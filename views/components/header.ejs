<link rel="stylesheet" href="/styles/header.css">

<header class="header">
  <nav class="h-nav">
    <ul class="nav-ul">
      <li><a href="/">Home</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>
  </nav>

  <!-- AUTH AREA: switches between guest buttons and profile -->
  <div class="auth-area" id="authArea">
    <!-- guests -->
    <div class="auth-guests" id="authGuests">
      <a href="/auth/login" class="nav-btn nav-btn-outline">ورود</a>
      <a href="/auth/register" class="nav-btn nav-btn-primary">ثبت نام</a>
    </div>

    <!-- logged-in user -->
    <div class="auth-profile" id="authProfile" style="display: none;">
      <button type="button" class="profile-btn" id="profileBtn" aria-haspopup="true" aria-expanded="false">
        <span class="profile-avatar" id="profileAvatar">
          <span id="profileInitial">U</span>
        </span>
        
        <span class="profile-name" id="profileName">User</span>

        <svg class="profile-caret" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>

      <div class="profile-menu" id="profileMenu">
        <a href="/dashboard/profile" class="profile-menu-item">پروفایل من</a>
        <a href="/dashboard/profile/settings" class="profile-menu-item">تنظیمات</a>
        <a href="/dashboard/projects" class="profile-menu-item">داشبورد</a>
        <div class="profile-menu-divider"></div>
        <button type="button" class="profile-menu-item logout" id="logoutBtn">خروج</button>
      </div>
    </div>
  </div>
</header>

<script src="/js/header.js"></script>