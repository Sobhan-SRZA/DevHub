{
  "name": "devhub",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build:css": "tailwindcss -i ./frontend/src/styles/tailwind.css -o ./frontend/public/styles/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./frontend/src/styles/tailwind.css -o ./frontend/public/styles/tailwind.css --watch --poll",
    "build": "npm run build:css && tsc",
    "start": "node .",
    "dev:server": "nodemon",
    "dev": "npm run build:css && concurrently -k -n css,server -c cyan,magenta \"npm run watch:css\" \"npm run dev:server\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "promote": "tsx backend/src/scripts/promoteUser.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sobhan-SRZA/devhub.git"
  },
  "keywords": [],
  "author": "",
  "license": "BSD-3-Clause",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Sobhan-SRZA/devhub/issues"
  },
  "homepage": "https://github.com/Sobhan-SRZA/devhub#readme",
  "dependencies": {
    "@persian-caesar/snowflake-id": "^1.4.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "ejs": "^7.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.2.1",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/ua-parser-js": "^0.7.39",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "dotenv": "^18.0.6",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
