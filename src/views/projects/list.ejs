<!-- views/projects/list.ejs -->
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles/index.css">
  <link rel="stylesheet" href="/styles/projects.css">
  <title>پروژه‌ها</title>
</head>

<body>
  <%- include("../components/header") %>

  <section class="container projects-page">
    <h1 class="page-title">پروژه‌های عمومی</h1>
    <p class="page-sub">پروژه‌های منتشرشده توسط کاربران</p>

    <div class="projects-filters">
      <input type="text" id="searchProjects" placeholder="جستجو...">
      <select id="sortProjects">
        <option value="recent">جدیدترین</option>
        <option value="rating">بیشترین امتیاز</option>
        <option value="downloads">بیشترین دانلود</option>
        <option value="stars">بیشترین ستاره</option>
      </select>
    </div>

    <div class="projects-grid" id="projectsGrid"></div>
    <div class="dash-pagination" id="pagination"></div>
  </section>

  <script src="/js/projects/list.js"></script>
</body>

</html>