<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles/index.css">
  <link rel="stylesheet" href="/styles/dialog.css">
  <link rel="stylesheet" href="/styles/form-errors.css">
  <link rel="stylesheet" href="/styles/dashboard/dashboard.css">
  <title>پروژه‌های من</title>
</head>

<body>
  <%- include("../components/header") %>
  <%- include("../components/dialogError") %>

  <div class="dash-layout">
    <%- include("../components/dashboard-nav") %>

    <main class="dash-main">
      <!-- mobile top bar -->
      <div class="dash-topbar">
        <button type="button" class="dash-menu-btn" onclick="toggleDashSidebar()" aria-label="منو">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <h1 class="dash-topbar__title">پروژه‌های من</h1>
      </div>

      <!-- header / actions -->
      <div class="dash-head">
        <div>
          <h2 class="dash-title">پروژه‌های من</h2>
          <p class="dash-sub" id="projectsCount">—</p>
        </div>
        <button type="button" class="btn-primary" id="btnNewProject">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          پروژه جدید
        </button>
      </div>

      <!-- filters -->
      <div class="dash-filters">
        <div class="dash-search">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" id="filterSearch" placeholder="جستجو در پروژه‌ها...">
        </div>

        <select id="filterStatus" class="dash-select">
          <option value="">همه وضعیت‌ها</option>
          <option value="draft">پیش‌نویس</option>
          <option value="published">منتشر شده</option>
          <option value="archived">آرشیو</option>
        </select>

        <select id="filterSort" class="dash-select">
          <option value="recent">جدیدترین</option>
          <option value="rating">بیشترین امتیاز</option>
          <option value="downloads">بیشترین دانلود</option>
          <option value="stars">بیشترین ستاره</option>
        </select>
      </div>

      <!-- grid -->
      <div class="dash-grid" id="projectsGrid">
        <div class="dash-loading">در حال بارگذاری…</div>
      </div>

      <!-- pagination -->
      <div class="dash-pagination" id="pagination"></div>
    </main>
  </div>

  <!-- ============================= -->
  <!-- PROJECT MODAL (create / edit) -->
  <!-- ============================= -->
  <div class="modal-backdrop" id="projectModalBackdrop"></div>
  <div class="modal" id="projectModal" role="dialog" aria-labelledby="projectModalTitle">
    <div class="modal__header">
      <h3 class="modal__title" id="projectModalTitle">پروژه جدید</h3>
      <button type="button" class="modal__close" id="projectModalClose" aria-label="بستن">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <form class="modal__body" id="projectForm" novalidate>
      <input type="hidden" name="_id">

      <div class="field">
        <label for="p-title">عنوان پروژه <span class="req">*</span></label>
        <input id="p-title" type="text" name="title" required maxlength="120" placeholder="مثلاً: سیستم مدیریت وظایف">
      </div>

      <div class="field">
        <label for="p-slug">Slug <small>(اختیاری — خودکار ساخته می‌شود)</small></label>
        <input id="p-slug" type="text" name="slug" maxlength="80" placeholder="task-manager">
        <div class="field-hint">فقط حروف انگلیسی کوچک، عدد و خط تیره</div>
      </div>

      <div class="field">
        <label for="p-githubUrl">لینک گیت‌هاب <small>(اختیاری)</small></label>
        <input id="p-githubUrl" type="url" name="githubUrl" maxlength="300" placeholder="https://github.com/owner/repo">
      </div>

      <div class="field">
        <label for="p-shortDescription">توضیحات مختصر <span class="req">*</span></label>
        <textarea id="p-shortDescription" name="shortDescription" rows="2" required maxlength="300" placeholder="یک توضیح کوتاه در چند کلمه..."></textarea>
        <div class="field-hint"><span id="shortCount">0</span> / 300</div>
      </div>

      <div class="field">
        <label for="p-fullDescription">شرح کامل <span class="req">*</span></label>
        <textarea id="p-fullDescription" name="fullDescription" rows="6" required maxlength="20000" placeholder="توضیح کامل پروژه، تکنولوژی‌ها، امکانات..."></textarea>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="p-rating">امتیاز (0 تا 5)</label>
          <input id="p-rating" type="number" name="rating" min="0" max="5" step="0.1" value="0">
        </div>
        <div class="field">
          <label for="p-satisfaction">رضایت (0 تا 100)</label>
          <input id="p-satisfaction" type="number" name="satisfaction" min="0" max="100" step="1" value="0">
        </div>
        <div class="field">
          <label for="p-downloads">تعداد دانلود</label>
          <input id="p-downloads" type="number" name="downloads" min="0" value="0">
        </div>
      </div>

      <div class="field">
        <label>تگ‌ها <small>(حداکثر ۲۰)</small></label>
        <div class="tag-picker" id="tagPicker">
          <div class="tag-picker__selected" id="tagPickerSelected"></div>
          <input type="text" class="tag-picker__search" id="tagPickerSearch" placeholder="جستجوی تگ یا ساخت جدید...">
          <div class="tag-picker__dropdown" id="tagPickerDropdown"></div>
        </div>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="p-status">وضعیت</label>
          <select id="p-status" name="status">
            <option value="draft">پیش‌نویس</option>
            <option value="published">منتشر شده</option>
            <option value="archived">آرشیو</option>
          </select>
        </div>
        <div class="field field--inline">
          <label class="checkbox">
            <input type="checkbox" name="isPublic" checked>
            <span>نمایش عمومی</span>
          </label>
          <label class="checkbox">
            <input type="checkbox" name="autoSync" checked>
            <span>سینک خودکار با گیت‌هاب</span>
          </label>
        </div>
      </div>
    </form>

    <div class="modal__footer">
      <button type="button" class="btn-ghost" id="projectModalCancel">انصراف</button>
      <button type="submit" form="projectForm" class="btn-primary" id="projectModalSubmit">ذخیره</button>
    </div>
  </div>

  <script src="/js/form-errors.js"></script>
  <script src="/js/dashboard/projects.js"></script>
</body>

</html>