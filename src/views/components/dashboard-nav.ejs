<link rel="stylesheet" href="/styles/dashboard.css">

<aside class="dash-sidebar" id="dashSidebar">
  <div class="dash-brand">
    <span class="dash-brand__icon">⚡</span>
    <span class="dash-brand__name">داشبورد</span>
  </div>

  <nav class="dash-nav">
    <a href="/dashboard" class="dash-nav__item" data-path="/dashboard">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="7" height="7"></rect>
        <rect x="14" y="3" width="7" height="7"></rect>
        <rect x="14" y="14" width="7" height="7"></rect>
        <rect x="3" y="14" width="7" height="7"></rect>
      </svg>
      <span>نمای کلی</span>
    </a>

    <a href="/dashboard/projects" class="dash-nav__item" data-path="/dashboard/projects">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
      </svg>
      <span>پروژه‌های من</span>
    </a>

    <a href="/dashboard/tags" class="dash-nav__item" data-path="/dashboard/tags">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
        <line x1="7" y1="7" x2="7.01" y2="7"></line>
      </svg>
      <span>تگ‌ها</span>
    </a>

    <a href="/dashboard/tag-types" class="dash-nav__item" data-path="/dashboard/tag-types">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="8" y1="6" x2="21" y2="6"></line>
        <line x1="8" y1="12" x2="21" y2="12"></line>
        <line x1="8" y1="18" x2="21" y2="18"></line>
        <line x1="3" y1="6" x2="3.01" y2="6"></line>
        <line x1="3" y1="12" x2="3.01" y2="12"></line>
        <line x1="3" y1="18" x2="3.01" y2="18"></line>
      </svg>
      <span>نوع تگ‌ها</span>
    </a>

    <div class="dash-nav__divider"></div>

    <a href="/" class="dash-nav__item">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        <polyline points="9 22 9 12 15 12 15 22"></polyline>
      </svg>
      <span>صفحه اصلی</span>
    </a>

    <a href="/dashboard/profile" class="dash-nav__item">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      <span>پروفایل</span>
    </a>
  </nav>

  <button type="button" class="dash-sidebar__close" id="dashSidebarClose" aria-label="بستن">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>
</aside>

<div class="dash-backdrop" id="dashBackdrop"></div>

<script>
  // active link highlight
  document.querySelectorAll('.dash-nav__item').forEach((a) => {
    if (a.dataset.path && a.dataset.path === location.pathname) a.classList.add('active');
  });

  // mobile toggle
  const sidebar = document.getElementById('dashSidebar');
  const backdrop = document.getElementById('dashBackdrop');
  const closeBtn = document.getElementById('dashSidebarClose');
  if (closeBtn) {
    closeBtn.addEventListener('click', () => {
      sidebar.classList.remove('open');
      backdrop.classList.remove('open');
    });
    backdrop?.addEventListener('click', () => {
      sidebar.classList.remove('open');
      backdrop.classList.remove('open');
    });
  }
  window.toggleDashSidebar = () => {
    sidebar.classList.toggle('open');
    backdrop.classList.toggle('open');
  };
</script>